<!DOCTYPE html>
<html lang={html_lang(@lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tr(@lang, fn -> gettext("Bulletin de notes") end)} — {@cg.label}</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: Georgia, "Times New Roman", serif;
        color: #111; background: #fff; margin: 0; padding: 24px;
        font-size: 12pt; line-height: 1.4;
      }
      .bulletin-page { page-break-after: always; position: relative; }
      .watermark {
        position: absolute; inset: 35% 0 auto 0; text-align: center;
        font-size: 96px; font-weight: 700; letter-spacing: 0.2em;
        color: rgba(0, 0, 0, 0.08); transform: rotate(-24deg); pointer-events: none;
      }
      .published { font-size: 11px; text-align: right; margin: 0 0 4px; }
      .bulletin-page:last-child { page-break-after: auto; }
      h1 { font-size: 15pt; margin: 8px 0 4px; text-align: center; }
      .cartouche { width: 100%; border-collapse: collapse; margin: 8px 0 12px; }
      .cartouche td { border: 1px solid #999; padding: 4px 8px; vertical-align: top; }
      .cartouche .k { font-variant: small-caps; color: #444; width: 18%; }
      table.body { width: 100%; border-collapse: collapse; margin-top: 8px; }
      table.body th, table.body td { border: 1px solid #999; padding: 6px 8px; text-align: left; }
      table.body th { background: #f0f0f0; font-variant: small-caps; }
      table.body td.num, table.body th.num { text-align: right; }
      .totals { margin-top: 8px; font-size: 12pt; }
      .totals strong { font-size: 13pt; }
      .visa { margin-top: 24px; display: flex; justify-content: space-between; gap: 16px; }
      .visa .slot { flex: 1; }
      .visa .head .marks { position: relative; height: 56px; }
      .visa .head .stamp { position: absolute; left: 10%; height: 56px; opacity: .85; }
      .visa .head .signature { position: absolute; right: 10%; height: 48px; }
      .visa .line { border-top: 1px solid #999; margin-top: 32px; padding-top: 2px;
                    font-variant: small-caps; font-size: 9pt; color: #444; }
      .visa .pp-name { font-size: 11px; margin-bottom: 2px; }
      .visa .decision { font-weight: bold; margin-bottom: 2px; }
      .appreciation { margin-top: 12px; }
      .appreciation .k { font-variant: small-caps; font-size: 9pt; color: #444; }
      .appreciation .rule { border-bottom: 1px solid #bbb; height: 20px; }
      @page { size: A4; margin: 15mm; }
      @media print {
        body { padding: 0; }
        tr { break-inside: avoid; }
      }
      tr.group th { text-align: left; font-size: 9pt; text-transform: uppercase; background: #f2f2f2; }
      tr.group-total td { font-weight: 600; }
      .header { display: flex; justify-content: space-between; gap: 12px; text-align: center; font-size: 9pt; }
      .header .col { flex: 1; }
      .header .col div:first-child { font-variant: small-caps; font-weight: bold; }
      .school { text-align: center; margin: 6px 0; font-size: 10pt; }
      .school .name { font-size: 13pt; font-weight: bold; }
      .school img { max-height: 56px; }
      .qr svg { width: 88px; height: 88px; }
      td .teacher { font-size: 9pt; color: #666; }
      .visa .head-name { font-size: 11px; margin-top: 2px; }
      .verify { font-size: 8pt; color: #444; max-width: 180px; word-break: break-all; margin: 4px 0 0; }
    </style>
  </head>
  <body>
    <section :for={b <- @bundles} class="bulletin-page">
      <div :if={@draft?} class="watermark">{tr(@lang, fn -> gettext("BROUILLON") end)}</div>
      <p :if={@published_on} class="published">
        {tr(@lang, fn -> gettext("Publié le %{date}", date: @published_on) end)}
      </p>

      <div class="header">
        <div :for={l <- header_columns(@lang, @template.header)} class="col">
          <div :for={line <- official_lines(l, @template.header)}>{line}</div>
        </div>
      </div>
      <div class="school">
        <img :if={@logo?} src={~p"/school/logo"} alt="" />
        <div
          :for={{line, i} <- Enum.with_index(school_lines(@lang, @template.header))}
          class={if i == 0, do: "name"}
        >
          {line}
        </div>
      </div>

      <h1>{tr(@lang, fn -> gettext("Bulletin de notes") end)}</h1>

      <table class="cartouche">
        <tr>
          <td class="k">{tr(@lang, fn -> gettext("Année scolaire") end)}</td>
          <td>{@annee || "—"}</td>
          <td class="k">{tr(@lang, fn -> gettext("Période") end)}</td>
          <td>{@period_heading}</td>
        </tr>
        <tr>
          <td class="k">{tr(@lang, fn -> gettext("Nom et prénoms") end)}</td>
          <td>{b.student.full_name}</td>
          <td class="k">{tr(@lang, fn -> gettext("Matricule") end)}</td>
          <td>{b.student.matricule || "—"}</td>
        </tr>
        <tr>
          <td class="k">{tr(@lang, fn -> gettext("Classe") end)}</td>
          <td>{@cg.label} — {@cg.level}</td>
          <td class="k">{tr(@lang, fn -> gettext("Sexe") end)}</td>
          <td>{tr(@lang, fn -> sex_label(b.student.sex) end)}</td>
        </tr>
        <%!-- Snapshots published before KLM1 carry no birth keys. --%>
        <tr :if={
          show?(@template, :birth) and
            (Map.get(b.student, :birth_date) || Map.get(b.student, :birth_place))
        }>
          <td class="k">{tr(@lang, fn -> gettext("Né(e) le") end)}</td>
          <td>
            {Map.get(b.student, :birth_date) &&
              Calendar.strftime(b.student.birth_date, "%d/%m/%Y")}
          </td>
          <td class="k">{tr(@lang, fn -> gettext("à") end)}</td>
          <td>{Map.get(b.student, :birth_place)}</td>
        </tr>
        <tr :if={show?(@template, :effectif)}>
          <td class="k">{tr(@lang, fn -> gettext("Effectif") end)}</td>
          <td>{@effectif}</td>
          <td></td>
          <td></td>
        </tr>
        <%!-- Snapshots published before the pilotage redesign may lack the repeater flag. --%>
        <tr :if={
          show?(@template, :repeater) or
            (show?(@template, :form_master) and @professeur_principal)
        }>
          <%= if show?(@template, :repeater) and not is_nil(repeater?(b.enrollment)) do %>
            <td class="k">{tr(@lang, fn -> gettext("Redoublant(e)") end)}</td>
            <td>
              {if repeater?(b.enrollment),
                do: tr(@lang, fn -> gettext("oui") end),
                else: tr(@lang, fn -> gettext("non") end)}
            </td>
          <% else %>
            <td></td>
            <td></td>
          <% end %>
          <%= if show?(@template, :form_master) and @professeur_principal do %>
            <td class="k">{tr(@lang, fn -> gettext("Professeur principal") end)}</td>
            <td>{@professeur_principal}</td>
          <% else %>
            <td></td>
            <td></td>
          <% end %>
        </tr>
      </table>

      <%= if b.data do %>
        <table class="body">
          <thead>
            <tr>
              <th>{tr(@lang, fn -> gettext("Matière") end)}</th>
              <th class="num">{tr(@lang, fn -> gettext("Coefficient") end)}</th>
              <%= case @period_kind do %>
                <% :trimester -> %>
                  <th class="num">{tr(@lang, fn -> gettext("Séq 1") end)}</th>
                  <th class="num">{tr(@lang, fn -> gettext("Séq 2") end)}</th>
                  <th class="num">{tr(@lang, fn -> gettext("Moy. trim.") end)}</th>
                <% :annual -> %>
                  <th class="num">{tr(@lang, fn -> gettext("Trim 1") end)}</th>
                  <th class="num">{tr(@lang, fn -> gettext("Trim 2") end)}</th>
                  <th class="num">{tr(@lang, fn -> gettext("Trim 3") end)}</th>
                  <th class="num">{tr(@lang, fn -> gettext("Moy. ann.") end)}</th>
                <% _ -> %>
                  <th class="num">{tr(@lang, fn -> gettext("Note") end)}/20</th>
              <% end %>
              <th class="num">{tr(@lang, fn -> gettext("Note×Coef") end)}</th>
              <%= if show?(@template, :subject_appreciation) do %>
                <%= if @template.grading == :grade do %>
                  <th>{tr(@lang, fn -> gettext("Grade") end)}</th>
                  <th>{tr(@lang, fn -> gettext("Remarque") end)}</th>
                <% else %>
                  <th>{tr(@lang, fn -> gettext("Appréciation") end)}</th>
                <% end %>
              <% end %>
              <th :if={show?(@template, :min_max)} class="num">
                {tr(@lang, fn -> gettext("Cote classe") end)}
              </th>
              <th :if={show?(@template, :subject_rank)} class="num">
                {tr(@lang, fn -> gettext("Rang") end)}
              </th>
            </tr>
          </thead>
          <tbody :for={g <- b.data.groups} id={"bulletin-group-#{g.group}"}>
            <tr class="group">
              <th colspan={body_cols(@period_kind, @template)}>
                {tr(@lang, fn -> group_label(g.group) end)}
              </th>
            </tr>
            <tr :for={row <- g.rows}>
              <td>
                {row.label}
                <div
                  :if={show?(@template, :subject_teacher) and @teachers[row.context_id]}
                  class="teacher"
                >
                  {@teachers[row.context_id]}
                </div>
              </td>
              <td class="num">{fmt(row.coefficient)}</td>
              <%= case @period_kind do %>
                <% :trimester -> %>
                  <td class="num">{fmt(comp(row, :sequences, 0))}</td>
                  <td class="num">{fmt(comp(row, :sequences, 1))}</td>
                  <td class="num">{fmt(row.average)}<sup :if={row.makeup_pending}>R</sup></td>
                <% :annual -> %>
                  <td class="num">{fmt(comp(row, :trimesters, 0))}</td>
                  <td class="num">{fmt(comp(row, :trimesters, 1))}</td>
                  <td class="num">{fmt(comp(row, :trimesters, 2))}</td>
                  <td class="num">{fmt(row.average)}<sup :if={row.makeup_pending}>R</sup></td>
                <% _ -> %>
                  <td class="num">{fmt(row.average)}<sup :if={row.makeup_pending}>R</sup></td>
              <% end %>
              <td class="num">{fmt(row.note_x_coef)}</td>
              <%= if show?(@template, :subject_appreciation) do %>
                <%= if @template.grading == :grade do %>
                  <% g = grade(@template, row.average) %>
                  <td>{g && g.letter}</td>
                  <td>{g && g.remark}</td>
                <% else %>
                  <td>{row.mention && row.mention.label}</td>
                <% end %>
              <% end %>
              <td :if={show?(@template, :min_max)} class="num">
                {if row.class_min, do: "#{fmt(row.class_min)} – #{fmt(row.class_max)}", else: "—"}
              </td>
              <td :if={show?(@template, :subject_rank)} class="num">{subject_rank(row)}</td>
            </tr>
            <tr :if={@group_subtotals?} id={"bulletin-group-total-#{g.group}"} class="group-total">
              <td>{tr(@lang, fn -> gettext("Total groupe") end)}</td>
              <td class="num">{fmt(g.total_coef)}</td>
              <td :for={_ <- 2..period_cols(@period_kind)//1}></td>
              <td class="num">{fmt(g.average)}</td>
              <td class="num">{fmt(g.total_points)}</td>
              <td :for={_ <- 1..trailing_cols(@template)//1}></td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th>
                {tr(@lang, fn -> gettext("Total des coefficients") end)} / {tr(@lang, fn ->
                  gettext("Total des points")
                end)}
              </th>
              <th class="num">{fmt(b.data.total_coef)}</th>
              <th :for={_ <- 1..period_cols(@period_kind)//1}></th>
              <th class="num">{fmt(b.data.total_points)}</th>
              <th :for={_ <- 1..trailing_cols(@template)//1}></th>
            </tr>
          </tfoot>
        </table>
        <p :if={Enum.any?(b.data.subjects, & &1.makeup_pending)} class="legend">
          {tr(@lang, fn -> gettext("R : rattrapage attendu") end)}
        </p>

        <p class="totals">
          <strong>
            {tr(@lang, fn -> gettext("Moyenne générale") end)} : {fmt(b.data.moyenne_generale)}/20
          </strong>
          <span :if={show?(@template, :rank)}>
            &nbsp;·&nbsp; {tr(@lang, fn -> gettext("Rang") end)} : {b.data.rank || "—"}<span :if={
              show?(@template, :effectif)
            }> / {@effectif}</span>
          </span>
          <span :if={show?(@template, :class_average) and @class_average}>
            &nbsp;·&nbsp; {tr(@lang, fn -> gettext("Moyenne de la classe") end)} : {fmt(
              @class_average
            )}
          </span>
          <%= if @template.grading == :grade do %>
            <% g = grade(@template, b.data.moyenne_generale) %>
            <span :if={g}>&nbsp;·&nbsp; {tr(@lang, fn -> gettext("Grade") end)} : {g.letter} — {g.remark}</span>
          <% else %>
            <span :if={b.data.mention}>&nbsp;·&nbsp; {b.data.mention.label}</span>
          <% end %>
          <span :if={(show?(@template, :class_extremes) and @highest) && @lowest}>
            &nbsp;·&nbsp; {tr(@lang, fn -> gettext("Plus forte") end)} : {fmt(@highest)} &nbsp;·&nbsp; {tr(
              @lang,
              fn -> gettext("plus faible") end
            )} : {fmt(@lowest)}
          </span>
          <span :if={b.distinction}>
            &nbsp;·&nbsp;
            <strong>
              {tr(@lang, fn -> TeacherAssistant.Academics.Distinction.label(b.distinction) end)}
            </strong>
          </span>
          <span :if={b.outcome && b.outcome.conduct_warning}>
            &nbsp;·&nbsp;
            <strong>
              {tr(@lang, fn ->
                TeacherAssistant.Academics.ConductWarning.label(b.outcome.conduct_warning)
              end)}
            </strong>
          </span>
        </p>
      <% else %>
        <p>{tr(@lang, fn -> gettext("No marks for this séquence yet.") end)}</p>
      <% end %>

      <p :if={b.conduct && show?(@template, :absences)} class="totals">
        <strong>{tr(@lang, fn -> gettext("Assiduité") end)}</strong>
        &nbsp;·&nbsp; {tr(@lang, fn -> gettext("Absences justifiées") end)} : {fmt(
          b.conduct.justified_hours
        )} h &nbsp;·&nbsp; {tr(@lang, fn -> gettext("Absences non justifiées") end)} : {fmt(
          b.conduct.unjustified_hours
        )} h &nbsp;·&nbsp; {tr(@lang, fn -> gettext("Retards") end)} : {b.conduct.retards}
      </p>

      <p :if={b.discipline && show?(@template, :conduct)} class="totals">
        <strong>{tr(@lang, fn -> gettext("Discipline") end)}</strong>
        &nbsp;·&nbsp; {tr(@lang, fn -> gettext("Consignes") end)} : {b.discipline.consignes_count} &nbsp;·&nbsp; {tr(
          @lang,
          fn -> gettext("Note de conduite") end
        )} : {fmt(b.discipline.note_de_conduite)}/20 &nbsp;·&nbsp; {tr(@lang, fn ->
          gettext("Sanctions")
        end)} : {tr(@lang, fn ->
          sanctions_line(b.discipline.sanctions)
        end)}
      </p>

      <div class="appreciation">
        <span class="k">{tr(@lang, fn -> gettext("Appréciation du conseil de classe") end)}</span>
        <p :if={b.outcome && b.outcome.appreciation} class="council-text">
          {b.outcome.appreciation}
        </p>
        <div :if={!(b.outcome && b.outcome.appreciation)} class="rule"></div>
      </div>

      <div class="visa">
        <div class="slot">
          <div :if={b.outcome && Map.get(b.outcome, :passage)} class="decision">
            {tr(@lang, fn ->
              TeacherAssistant.Academics.PassageDecision.label(b.outcome.passage)
            end)}
          </div>
          <div class="line">{tr(@lang, fn -> gettext("Décision") end)}</div>
        </div>
        <div :if={show?(@template, :pp_signature)} class="slot">
          <div :if={@professeur_principal} class="pp-name">{@professeur_principal}</div>
          <div class="line">{tr(@lang, fn -> gettext("Visa Professeur Principal") end)}</div>
        </div>
        <div :if={show?(@template, :parent_visa)} class="slot">
          <div class="line">{tr(@lang, fn -> gettext("Visa du parent") end)}</div>
        </div>
        <div class="slot head">
          <div class="marks">
            <img
              :if={show?(@template, :stamp) and Map.get(@template.header, :stamp?)}
              class="stamp"
              src={~p"/school/logo?kind=stamp"}
              alt=""
            />
            <img
              :if={show?(@template, :signature) and Map.get(@template.header, :signature?)}
              class="signature"
              src={~p"/school/logo?kind=signature"}
              alt=""
            />
          </div>
          <div class="line">{tr(@lang, fn -> gettext("Visa Chef d'établissement") end)}</div>
          <div :if={show?(@template, :parent_visa) and @head_name} class="head-name">
            {@head_name}
          </div>
        </div>
        <div :if={b.qr_svg || (show?(@template, :verify_link) and b.verify_url)} class="qr">
          {b.qr_svg && Phoenix.HTML.raw(b.qr_svg)}
          <p :if={show?(@template, :verify_link) and b.verify_url} class="verify">
            {tr(@lang, fn -> gettext("Vérifiable en ligne") end)} : {b.verify_url}
          </p>
        </div>
      </div>
    </section>
  </body>
</html>
