<!DOCTYPE html>
<html lang={html_lang(@lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tr(@lang, fn -> gettext("Bulletin de notes") end)} — {@cg.label}</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: "IBM Plex Sans", Arial, Helvetica, sans-serif;
        color: #111; background: #fff; margin: 0; padding: 16px;
        line-height: 1.22;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      @page { size: A4; margin: 10mm; }
      @media print { body { padding: 0; } tr { break-inside: avoid; } }
      .bulletin-page { page-break-after: always; position: relative; font-size: 8pt; }
      .bulletin-page:last-child { page-break-after: auto; }
      .density-compact { font-size: 7.4pt; }
      .density-dense, .density-overflow { font-size: 6.4pt; }
      .watermark {
        position: absolute; inset: 35% 0 auto 0; text-align: center;
        font-size: 96px; font-weight: 700; letter-spacing: 0.2em;
        color: rgba(0, 0, 0, 0.08); transform: rotate(-24deg); pointer-events: none;
      }
      .published { font-size: 0.8em; text-align: right; margin: 0 0 2px; color: #555; }
      table { border-collapse: collapse; width: 100%; }
      td, th { border: 0.2mm solid #555; padding: 0.5mm 1mm; vertical-align: middle; }
      .density-dense td, .density-dense th, .density-overflow td, .density-overflow th { padding: 0.3mm 0.8mm; }
      .header { display: grid; grid-template-columns: 1fr 36mm 1fr; gap: 2mm; text-align: center; font-size: 0.86em; }
      .header .col div:first-child { font-weight: bold; text-transform: uppercase; }
      .header .col div:nth-child(2) { font-style: italic; }
      .header .col div:nth-child(n+3) { text-transform: uppercase; }
      .header .mid img { max-height: 18mm; max-width: 30mm; }
      .header .code { font-weight: 700; margin-top: 1mm; letter-spacing: .02em; }
      .school { display: grid; grid-template-columns: 1fr 36mm 1fr; gap: 2mm; text-align: center; margin-top: 1mm; font-size: 0.9em; }
      .school .name { font-size: 1.2em; font-weight: bold; text-transform: uppercase; }
      .flag { height: 0.9mm; margin: 1.2mm 0 0;
              background: linear-gradient(90deg, #007a5e 33.3%, #ce1126 33.3% 66.6%, #fcd116 66.6%); }
      .title { text-align: center; margin: 1.5mm 0 1.2mm; }
      .title h1 { font-size: 1.45em; margin: 0; letter-spacing: .04em; text-transform: uppercase; }
      .title .year { font-size: 1.05em; }
      .identity { display: flex; gap: 2mm; align-items: flex-start; }
      .identity .cartouche { flex: 1; }
      .cartouche td { padding: 0.6mm 1.2mm; }
      .cartouche .k { color: #444; white-space: nowrap; font-size: 0.92em; }
      .student-photo { width: 24mm; height: 30mm; object-fit: cover; border: 0.3mm solid #000; }
      table.body { margin-top: 1.5mm; }
      table.body th { background: #eee; font-weight: 700; text-align: center; font-size: 0.9em; }
      table.body td.num, table.body th.num { text-align: center; }
      table.body .comp { font-size: 0.9em; max-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      table.body th.comp { width: 30%; }
      table.body tfoot th { background: #f6f6f6; }
      tr.group th { text-align: left; text-transform: uppercase; background: #f2f2f2; }
      tr.group-total td { font-weight: 600; }
      td .teacher { font-size: 0.85em; color: #555; }
      .legend { margin: 0.5mm 0 0; font-size: 0.85em; }
      .boxes { display: flex; gap: 1.5mm; margin-top: 1.5mm; align-items: flex-start; }
      .boxes table { flex: 1; }
      .boxes th { background: #eee; text-align: center; }
      .boxes td.v { text-align: center; font-weight: 600; white-space: nowrap; width: 1%; }
      .boxes td.wide { font-size: 0.92em; }
      .bottom { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5mm; margin-top: 1.5mm; }
      .bottom th { background: #eee; text-align: left; }
      .bottom td { height: 9mm; vertical-align: top; }
      .council-text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 0; }
      .decision { font-weight: bold; }
      .visa { display: flex; gap: 1.5mm; margin-top: 1.5mm; }
      .visa .slot { flex: 1; border: 0.2mm solid #555; min-height: 18mm; padding: 1mm; position: relative; }
      .visa .slot.head { flex: 1.4; }
      .visa .line { color: #444; }
      .visa .pp-name, .visa .head-name { margin-top: 1mm; }
      .visa .head .marks { position: relative; height: 11mm; }
      .visa .head .stamp { position: absolute; left: 6%; height: 11mm; opacity: .85; }
      .visa .head .signature { position: absolute; right: 6%; height: 10mm; }
      .qr { border: 0.2mm solid #555; padding: 1mm; text-align: center; }
      .qr svg { width: 20mm; height: 20mm; }
      .verify { font-size: 0.75em; color: #444; max-width: 32mm; word-break: break-all; margin: 0.5mm 0 0; }
    </style>
  </head>
  <body>
    <section :for={b <- @bundles} class={["bulletin-page", "density-#{b.density}"]}>
      <div :if={@draft?} class="watermark">{tr(@lang, fn -> gettext("BROUILLON") end)}</div>
      <p :if={@published_on} class="published">
        {tr(@lang, fn -> gettext("Publié le %{date}", date: @published_on) end)}
      </p>

      <div class="header">
        <div class="col">
          <div :for={line <- official_lines(@template.header, :fr)}>{line}</div>
        </div>
        <div class="mid">
          <img :if={@logo?} src={~p"/school/logo"} alt="" />
          <div :if={present?(Map.get(@template.header, :school_code))} class="code">
            CODE : {@template.header.school_code}
          </div>
        </div>
        <div class="col">
          <div :for={line <- official_lines(@template.header, :en)}>{line}</div>
        </div>
      </div>
      <div class="school">
        <div>
          <div
            :for={{line, i} <- Enum.with_index(school_lines(@template.header, :fr))}
            class={if i == 0, do: "name"}
          >
            {line}
          </div>
        </div>
        <div></div>
        <div>
          <div
            :for={{line, i} <- Enum.with_index(school_lines(@template.header, :en))}
            class={if i == 0, do: "name"}
          >
            {line}
          </div>
        </div>
      </div>
      <div class="flag"></div>

      <div class="title">
        <h1>{@title}</h1>
        <div class="year">{tr(@lang, fn -> gettext("Année scolaire") end)} {@annee || "—"}</div>
      </div>

      <div class="identity">
        <img
          :if={show?(@template, :photo) and b.photo_url}
          class="student-photo"
          src={b.photo_url}
          alt=""
        />
        <table class="cartouche">
          <tr>
            <td class="k">{tr(@lang, fn -> gettext("Nom et prénoms") end)}</td>
            <td colspan="3"><strong>{b.student.full_name}</strong></td>
            <td class="k">{tr(@lang, fn -> gettext("Classe") end)}</td>
            <td><strong>{@cg.label}</strong></td>
          </tr>
          <tr>
            <%!-- Snapshots published before KLM1 carry no birth keys. --%>
            <%= if show?(@template, :birth) and (Map.get(b.student, :birth_date) || Map.get(b.student, :birth_place)) do %>
              <td class="k">{tr(@lang, fn -> gettext("Né(e) le") end)}</td>
              <td colspan="3">
                {Map.get(b.student, :birth_date) &&
                  Calendar.strftime(b.student.birth_date, "%d/%m/%Y")}
                <span :if={Map.get(b.student, :birth_place)}>
                  {tr(@lang, fn -> gettext("à") end)} {b.student.birth_place}
                </span>
              </td>
            <% else %>
              <td class="k">{tr(@lang, fn -> gettext("Niveau") end)}</td>
              <td colspan="3">{@cg.level}</td>
            <% end %>
            <td class="k">{tr(@lang, fn -> gettext("Sexe") end)}</td>
            <td>{tr(@lang, fn -> sex_label(b.student.sex) end)}</td>
          </tr>
          <tr>
            <%= if show?(@template, :national_id) and Map.get(b.student, :national_id) do %>
              <td class="k">{tr(@lang, fn -> gettext("Identifiant unique") end)}</td>
              <td>{b.student.national_id}</td>
            <% else %>
              <td></td>
              <td></td>
            <% end %>
            <td class="k">{tr(@lang, fn -> gettext("Matricule") end)}</td>
            <td>{b.student.matricule || "—"}</td>
            <%= if show?(@template, :effectif) do %>
              <td class="k">{tr(@lang, fn -> gettext("Effectif") end)}</td>
              <td>{@effectif}</td>
            <% else %>
              <td></td>
              <td></td>
            <% end %>
          </tr>
          <%!-- Snapshots published before the pilotage redesign may lack the repeater flag. --%>
          <tr :if={
            show?(@template, :repeater) or
              (show?(@template, :form_master) and @professeur_principal)
          }>
            <%= if show?(@template, :repeater) and not is_nil(repeater?(b.enrollment)) do %>
              <td class="k">{tr(@lang, fn -> gettext("Redoublant(e)") end)}</td>
              <td>
                {if repeater?(b.enrollment),
                  do: tr(@lang, fn -> gettext("oui") end),
                  else: tr(@lang, fn -> gettext("non") end)}
              </td>
            <% else %>
              <td></td>
              <td></td>
            <% end %>
            <%= if show?(@template, :form_master) and @professeur_principal do %>
              <td class="k">{tr(@lang, fn -> gettext("Professeur principal") end)}</td>
              <td colspan="3">{@professeur_principal}</td>
            <% else %>
              <td></td>
              <td colspan="3"></td>
            <% end %>
          </tr>
          <tr :if={show?(@template, :guardians) and b.guardians != []}>
            <td class="k">{tr(@lang, fn -> gettext("Parents / tuteurs") end)}</td>
            <td colspan="5">{guardians_line(b.guardians)}</td>
          </tr>
        </table>
      </div>

      <%= if b.data do %>
        <table class="body">
          <thead>
            <tr>
              <th>{tr(@lang, fn -> gettext("Matière") end)}</th>
              <th :if={apc?(@template, @period_kind)} class="comp">
                {tr(@lang, fn -> gettext("Compétences évaluées") end)}
              </th>
              <th
                :for={h <- mark_headers(@lang, @period_kind, @template, @sequences_per_term)}
                class="num"
              >
                {h}
              </th>
              <th class="num">{tr(@lang, fn -> gettext("Coef.") end)}</th>
              <th class="num">{tr(@lang, fn -> gettext("Note×Coef") end)}</th>
              <th :if={cote?(@template)} class="num">{tr(@lang, fn -> gettext("Cote") end)}</th>
              <th :if={show?(@template, :min_max)} class="num">
                {tr(@lang, fn -> gettext("Min – Max") end)}
              </th>
              <th :if={show?(@template, :subject_rank)} class="num">
                {tr(@lang, fn -> gettext("Rang") end)}
              </th>
              <%= if show?(@template, :subject_appreciation) do %>
                <%= if @template.grading == :grade do %>
                  <th>{tr(@lang, fn -> gettext("Grade") end)}</th>
                  <th>{tr(@lang, fn -> gettext("Remarque") end)}</th>
                <% else %>
                  <th>{tr(@lang, fn -> gettext("Appréciation") end)}</th>
                <% end %>
              <% end %>
              <th :if={show?(@template, :teacher_visa)}>
                {tr(@lang, fn -> gettext("Visa") end)}
              </th>
            </tr>
          </thead>
          <tbody :for={g <- b.data.groups} id={"bulletin-group-#{g.group}"}>
            <tr class="group">
              <th colspan={column_count(@period_kind, @template, @sequences_per_term)}>
                {tr(@lang, fn -> group_label(g.group) end)}
              </th>
            </tr>
            <%= for row <- g.rows do %>
              <%= if apc_lines?(@template, @period_kind) do %>
                <% lines = sequence_lines(row, @competences, @sequences_per_term) %>
                <tr :for={{line, i} <- Enum.with_index(lines)}>
                  <td :if={i == 0} rowspan={length(lines)}>
                    <.subject_cell row={row} template={@template} teachers={@teachers} />
                  </td>
                  <td class="comp">
                    {tr(@lang, fn -> gettext("Séq %{n}", n: line.number || line.position) end)}<span :if={
                      line.text
                    }> · {line.text}</span>
                  </td>
                  <td class="num">{fmt(line.mark)}</td>
                  <.row_tail
                    :if={i == 0}
                    row={row}
                    rowspan={length(lines)}
                    template={@template}
                  />
                </tr>
              <% else %>
                <tr>
                  <td><.subject_cell row={row} template={@template} teachers={@teachers} /></td>
                  <td :if={apc?(@template, @period_kind)} class="comp">
                    {sequence_competence(row, @competences)}
                  </td>
                  <td :for={mark <- pre_marks(row, @period_kind, @sequences_per_term)} class="num">
                    {fmt(mark)}
                  </td>
                  <.row_tail row={row} rowspan={1} template={@template} />
                </tr>
              <% end %>
            <% end %>
            <tr :if={@group_subtotals?} id={"bulletin-group-total-#{g.group}"} class="group-total">
              <td>{tr(@lang, fn -> gettext("Total groupe") end)}</td>
              <td :for={_ <- 1..lead_blanks(@period_kind, @template, @sequences_per_term)//1}>
              </td>
              <td class="num">{fmt(g.average)}</td>
              <td class="num">{fmt(g.total_coef)}</td>
              <td class="num">{fmt(g.total_points)}</td>
              <td :for={_ <- 1..trailing_cols(@template)//1}></td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th>{tr(@lang, fn -> gettext("Total") end)}</th>
              <th :for={_ <- 1..lead_blanks(@period_kind, @template, @sequences_per_term)//1}>
              </th>
              <th class="num">{fmt(b.data.moyenne_generale)}</th>
              <th class="num">{fmt(b.data.total_coef)}</th>
              <th class="num">{fmt(b.data.total_points)}</th>
              <th :for={_ <- 1..trailing_cols(@template)//1}></th>
            </tr>
          </tfoot>
        </table>
        <p :if={Enum.any?(b.data.subjects, & &1.makeup_pending)} class="legend">
          {tr(@lang, fn -> gettext("R : rattrapage attendu") end)}
        </p>
      <% else %>
        <p>{tr(@lang, fn -> gettext("No marks for this séquence yet.") end)}</p>
      <% end %>

      <div class="boxes">
        <table :if={
          (b.conduct && show?(@template, :absences)) ||
            (b.discipline && show?(@template, :conduct))
        }>
          <tr>
            <th colspan="2">{tr(@lang, fn -> gettext("Assiduité & discipline") end)}</th>
          </tr>
          <%= if b.conduct && show?(@template, :absences) do %>
            <tr>
              <td>{tr(@lang, fn -> gettext("Absences non justifiées") end)}</td>
              <td class="v">{fmt(b.conduct.unjustified_hours)} h</td>
            </tr>
            <%!-- Spec 2026-10-30 §5: a class typed by hand prints its one figure. --%>
            <%= if Map.get(b.conduct, :source, :roll_call) == :roll_call do %>
              <tr>
                <td>{tr(@lang, fn -> gettext("Absences justifiées") end)}</td>
                <td class="v">{fmt(b.conduct.justified_hours)} h</td>
              </tr>
              <tr>
                <td>{tr(@lang, fn -> gettext("Retards") end)}</td>
                <td class="v">{b.conduct.retards}</td>
              </tr>
            <% end %>
          <% end %>
          <%= if b.discipline && show?(@template, :conduct) do %>
            <tr>
              <td>{tr(@lang, fn -> gettext("Consignes") end)}</td>
              <td class="v">{b.discipline.consignes_count}</td>
            </tr>
            <tr>
              <td>{tr(@lang, fn -> gettext("Note de conduite") end)}</td>
              <td class="v">{fmt(b.discipline.note_de_conduite)}/20</td>
            </tr>
            <tr>
              <td colspan="2" class="wide">
                {tr(@lang, fn -> gettext("Sanctions") end)} : {tr(@lang, fn ->
                  sanctions_line(b.discipline.sanctions)
                end)}
              </td>
            </tr>
          <% end %>
        </table>

        <table :if={b.data}>
          <tr>
            <th colspan="2">{tr(@lang, fn -> gettext("Travail de l'élève") end)}</th>
          </tr>
          <tr>
            <td>{tr(@lang, fn -> gettext("Moyenne générale") end)}</td>
            <td class="v">{fmt(b.data.moyenne_generale)}/20</td>
          </tr>
          <tr :if={show?(@template, :rank)}>
            <td>{tr(@lang, fn -> gettext("Rang") end)}</td>
            <td class="v">
              {b.data.rank || "—"}<span :if={show?(@template, :effectif)}> / {@effectif}</span>
            </td>
          </tr>
          <tr :for={p <- b.prior}>
            <td>{tr(@lang, fn -> gettext("Moyenne trim. %{n}", n: p.position) end)}</td>
            <td class="v">
              {fmt(p.average)}<span :if={show?(@template, :rank) and p.rank}> · {p.rank}</span>
            </td>
          </tr>
          <%= if b.annual do %>
            <tr>
              <td>{tr(@lang, fn -> gettext("Moyenne annuelle") end)}</td>
              <td class="v">{fmt(b.annual.average)}</td>
            </tr>
            <tr :if={show?(@template, :rank)}>
              <td>{tr(@lang, fn -> gettext("Rang annuel") end)}</td>
              <td class="v">{b.annual.rank || "—"}</td>
            </tr>
          <% end %>
        </table>

        <table :if={b.data && cote?(@template)} id="cotes-box">
          <tr>
            <th colspan="2">{tr(@lang, fn -> gettext("Cotes") end)}</th>
          </tr>
          <tr :for={{code, count} <- cote_counts(b.data.subjects, @template.cote_codes)}>
            <td>{code}</td>
            <td class="v">{count}</td>
          </tr>
        </table>

        <table :if={class_profile_rows?(@template, @class_average, @highest, @class_profile)}>
          <tr>
            <th colspan="2">{tr(@lang, fn -> gettext("Profil de la classe") end)}</th>
          </tr>
          <tr :if={show?(@template, :class_average) and @class_average}>
            <td>{tr(@lang, fn -> gettext("Moyenne de la classe") end)}</td>
            <td class="v">{fmt(@class_average)}</td>
          </tr>
          <tr :if={(show?(@template, :class_extremes) and @highest) && @lowest}>
            <td>
              {tr(@lang, fn -> gettext("Plus forte") end)} / {tr(@lang, fn ->
                gettext("plus faible")
              end)}
            </td>
            <td class="v">{fmt(@highest)} / {fmt(@lowest)}</td>
          </tr>
          <%= if show?(@template, :class_profile) and @class_profile do %>
            <tr>
              <td>{tr(@lang, fn -> gettext("Moyennes ≥ 10") end)}</td>
              <td class="v">{@class_profile.passing}</td>
            </tr>
            <tr>
              <td>{tr(@lang, fn -> gettext("Taux de réussite") end)}</td>
              <td class="v">
                {if @class_profile.rate, do: "#{@class_profile.rate} %", else: "—"}
              </td>
            </tr>
          <% end %>
        </table>
      </div>

      <div class="bottom">
        <table>
          <tr>
            <th>{tr(@lang, fn -> gettext("Appréciation du conseil de classe") end)}</th>
          </tr>
          <tr>
            <td>
              <p :if={b.outcome && b.outcome.appreciation} class="council-text">
                {b.outcome.appreciation}
              </p>
            </td>
          </tr>
        </table>
        <table>
          <tr>
            <th>{tr(@lang, fn -> gettext("Distinction · Décision") end)}</th>
          </tr>
          <tr>
            <td>
              <%= if b.data do %>
                <%= if @template.grading == :grade do %>
                  <% g = grade(@template, b.data.moyenne_generale) %>
                  <div :if={g}>
                    {tr(@lang, fn -> gettext("Grade") end)} : {g.letter} — {g.remark}
                  </div>
                <% else %>
                  <div :if={b.data.mention}>{b.data.mention.label}</div>
                <% end %>
              <% end %>
              <strong :if={b.distinction}>
                {tr(@lang, fn -> TeacherAssistant.Academics.Distinction.label(b.distinction) end)}
              </strong>
              <strong :if={b.outcome && b.outcome.conduct_warning}>
                · {tr(@lang, fn ->
                  TeacherAssistant.Academics.ConductWarning.label(b.outcome.conduct_warning)
                end)}
              </strong>
              <div :if={b.decision} class="decision">
                {tr(@lang, fn -> TeacherAssistant.Academics.PassageDecision.label(b.decision) end)}
              </div>
            </td>
          </tr>
        </table>
      </div>

      <div class="visa">
        <div :if={show?(@template, :parent_visa)} class="slot">
          <div class="line">{tr(@lang, fn -> gettext("Visa du parent") end)}</div>
        </div>
        <div :if={show?(@template, :pp_signature)} class="slot">
          <div class="line">{tr(@lang, fn -> gettext("Visa Professeur Principal") end)}</div>
          <div :if={@professeur_principal} class="pp-name">{@professeur_principal}</div>
        </div>
        <div class="slot head">
          <div class="line">
            {head_title(@lang, @template.header)}
            {tr(@lang, fn ->
              gettext("Fait à %{town}, le %{date}",
                town: Map.get(@template.header, :town) || "……",
                date: @published_on || "……"
              )
            end)}
          </div>
          <div class="marks">
            <img
              :if={show?(@template, :stamp) and Map.get(@template.header, :stamp?)}
              class="stamp"
              src={~p"/school/logo?kind=stamp"}
              alt=""
            />
            <img
              :if={show?(@template, :signature) and Map.get(@template.header, :signature?)}
              class="signature"
              src={~p"/school/logo?kind=signature"}
              alt=""
            />
          </div>
          <div
            :if={show?(@template, :parent_visa) and head_name(@template, @head_name)}
            class="head-name"
          >
            {head_name(@template, @head_name)}
          </div>
          <div class="line">{tr(@lang, fn -> gettext("Visa Chef d'établissement") end)}</div>
        </div>
        <div :if={b.qr_svg || (show?(@template, :verify_link) and b.verify_url)} class="qr">
          {b.qr_svg && Phoenix.HTML.raw(b.qr_svg)}
          <p :if={show?(@template, :verify_link) and b.verify_url} class="verify">
            {tr(@lang, fn -> gettext("Vérifiable en ligne") end)} : {b.verify_url}
          </p>
        </div>
      </div>
    </section>
  </body>
</html>
