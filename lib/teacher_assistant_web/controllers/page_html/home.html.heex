<%!--
  Landing v2 (2026-11): schools only, in the app's « Tableau, affiné » look (daisyUI
  tokens, so it follows the visitor's theme). Rendered on the root layout with its
  own header and footer. The pictures of the app are drawn in HTML (aria-hidden);
  data lists and small formatters live in PageHTML.
--%>
<div class="ta-landing flex min-h-screen flex-col bg-base-200 text-base-content">
  <a
    href="#contenu"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-base-100 focus:px-4 focus:py-3"
  >
    {gettext("Aller au contenu")}
  </a>

  <header class="sticky top-0 z-30 border-b border-base-300 bg-base-200/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-2 sm:gap-3 sm:px-6">
      <a href={~p"/"} class="flex min-h-11 min-w-0 items-center">
        <Layouts.logo class="h-7 w-auto" />
      </a>
      <nav class="ml-4 hidden items-center gap-0.5 xl:flex" aria-label={gettext("Sections")}>
        <a :for={{href, label} <- sections()} href={href} class="ta-landing__nav !px-2.5">
          {label}
        </a>
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <nav
          class="hidden items-center font-mono text-[0.8rem] lg:flex"
          aria-label={gettext("Langue")}
        >
          <.link
            href={~p"/locale/fr"}
            class="ta-landing__nav !px-2"
            lang="fr"
            aria-current={locale() == "fr" && "true"}
          >
            FR
          </.link>
          <span class="ta-text-2" aria-hidden="true">·</span>
          <.link
            href={~p"/locale/en"}
            class="ta-landing__nav !px-2"
            lang="en"
            aria-current={locale() == "en" && "true"}
          >
            EN
          </.link>
        </nav>
        <.link
          :if={@current_user}
          id="landing-my-space"
          href={~p"/school"}
          class="btn btn-outline ta-landing__strong-rule min-h-11 px-2.5 text-[0.8125rem] sm:px-4 sm:text-sm"
        >
          {gettext("Mon espace")}
        </.link>
        <.link
          :if={!@current_user}
          href={~p"/sign-in"}
          class="btn btn-outline ta-landing__strong-rule min-h-11 px-2.5 text-[0.8125rem] sm:px-4 sm:text-sm"
        >
          {gettext("Se connecter")}
        </.link>
        <.link
          href={~p"/schools/start"}
          class="btn btn-primary hidden min-h-11 px-4 md:inline-flex"
        >
          {gettext("Inscrire mon établissement")}
        </.link>

        <details id="landing-menu" class="ta-landing__menu relative xl:hidden" data-close-on-link>
          <summary class="-mr-2 grid size-11 cursor-pointer place-items-center rounded-lg">
            <span class="sr-only">{gettext("Menu")}</span>
            <.icon name="hero-bars-3" class="ta-landing__menu-open size-6" />
            <.icon name="hero-x-mark" class="ta-landing__menu-close size-6" />
          </summary>
          <div class="absolute right-0 top-full mt-2 w-[min(18rem,calc(100vw-2rem))] rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
            <nav aria-label={gettext("Sections")}>
              <ul class="flex flex-col">
                <li :for={{href, label} <- sections()}>
                  <a href={href} class="ta-landing__nav w-full !text-base">{label}</a>
                </li>
              </ul>
            </nav>
            <div class="mt-1 flex items-center gap-1 border-t border-base-300 px-1 pt-2 lg:hidden">
              <nav
                class="flex items-center font-mono text-[0.85rem]"
                aria-label={gettext("Langue")}
              >
                <.link
                  href={~p"/locale/fr"}
                  class="ta-landing__nav min-w-11 justify-center"
                  lang="fr"
                  aria-current={locale() == "fr" && "true"}
                >
                  FR
                </.link>
                <.link
                  href={~p"/locale/en"}
                  class="ta-landing__nav min-w-11 justify-center"
                  lang="en"
                  aria-current={locale() == "en" && "true"}
                >
                  EN
                </.link>
              </nav>
            </div>
            <.link
              href={~p"/schools/start"}
              class="btn btn-primary mt-2 min-h-11 w-full md:hidden"
            >
              {gettext("Inscrire mon établissement")}
            </.link>
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="contenu" class="flex-1">
    <%!-- HERO --%>
    <section
      aria-labelledby="landing-title"
      class="mx-auto grid max-w-6xl items-center gap-10 px-4 pt-8 sm:px-6 md:pb-14 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,1fr)] lg:gap-12 lg:pb-16 lg:pt-16"
    >
      <div>
        <p class="ta-landing__eyebrow">
          <span class="sm:hidden">{gettext("Lycées et collèges du Cameroun")}</span>
          <span class="hidden sm:inline">
            {gettext("Lycées et collèges du Cameroun · francophones et anglophones")}
          </span>
        </p>
        <h1
          id="landing-title"
          class="mt-4 text-[2rem] font-semibold leading-[1.08] tracking-[-0.01em] sm:text-5xl lg:text-[3.5rem] lg:leading-[1.05] [text-wrap:balance]"
        >
          {headline()}
        </h1>
        <p class="ta-landing__lead mt-5 max-w-[34rem] text-base leading-relaxed sm:text-lg [text-wrap:pretty]">
          {lede()}
        </p>
        <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:gap-3">
          <.link href={~p"/schools/start"} class="btn btn-primary btn-lg min-h-13">
            {gettext("Inscrire mon établissement")}
            <.icon name="hero-arrow-right" class="size-5" />
          </.link>
          <.link
            :if={!@current_user}
            href={~p"/sign-in"}
            class="btn btn-outline btn-lg ta-landing__strong-rule min-h-13"
          >
            {gettext("Je suis enseignant : me connecter")}
          </.link>
          <.link
            :if={@current_user}
            href={~p"/school"}
            class="btn btn-outline btn-lg ta-landing__strong-rule min-h-13"
          >
            {gettext("Mon espace")}
          </.link>
        </div>
        <a
          :if={contact_whatsapp()}
          id="landing-demo"
          href={whatsapp_url(demo_message())}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-primary underline-offset-4 hover:underline"
        >
          <.icon name="hero-chat-bubble-left-right" class="size-5" />
          {gettext("Demander une démonstration sur WhatsApp")}
        </a>
        <ul class="ta-text-2 mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-[0.85rem] sm:text-sm">
          <li class="inline-flex items-center gap-1.5">
            <.icon name="hero-check" class="size-4 text-primary" />
            {gettext("Gratuit pendant la phase pilote")}
          </li>
          <li class="hidden items-center gap-1.5 sm:inline-flex">
            <.icon name="hero-check" class="size-4 text-primary" />
            {gettext("Fonctionne sur tout smartphone")}
          </li>
          <li class="hidden items-center gap-1.5 sm:inline-flex">
            <.icon name="hero-check" class="size-4 text-primary" />
            {gettext("Comptes par numéro de téléphone")}
          </li>
          <li class="inline-flex items-center gap-1.5 sm:hidden">
            <.icon name="hero-check" class="size-4 text-primary" />
            {gettext("Comptes par téléphone")}
          </li>
          <li class="inline-flex items-center gap-1.5 sm:hidden">
            <.icon name="hero-check" class="size-4 text-primary" /> Français · English
          </li>
        </ul>
      </div>

      <%!-- the app, drawn: the censeur's entry tracking + a teacher's phone --%>
      <div
        aria-hidden="true"
        class="relative mx-auto w-full max-w-[34rem] select-none md:h-[470px] lg:max-w-none"
      >
        <div class="ta-landing__window absolute left-[7.5rem] right-0 top-0 ml-auto hidden max-w-[440px] md:block">
          <div class="flex h-[26px] items-center gap-1.5 border-b border-base-300 px-2.5">
            <span class="ta-landing__dot"></span>
            <span class="ta-landing__dot"></span>
            <span class="ta-landing__dot"></span>
          </div>
          <div class="flex flex-col gap-2.5 p-4">
            <p class="ta-display text-lg font-semibold">
              {gettext("Suivi de la saisie · Séq. 2")}
            </p>
            <div
              :for={{name, pct} <- entry_bars()}
              class="flex items-center gap-2.5 pl-[5rem] text-xs"
            >
              <span class="ta-text-2 w-[4.5rem] flex-none">{name}</span>
              <span class="h-[7px] flex-1 overflow-hidden rounded bg-base-300">
                <span
                  class={["block h-full", if(pct == 100, do: "bg-primary", else: "bg-secondary")]}
                  style={"width: #{pct}%"}
                ></span>
              </span>
              <span class="ta-num ta-text-2 w-[2.6rem] flex-none text-right">{percent(pct)}</span>
            </div>
          </div>
        </div>

        <div class="ta-landing__phone mx-auto flex h-[15.5rem] w-[230px] flex-col gap-2 px-3 pt-3.5 md:absolute md:bottom-0 md:left-0 md:mx-0 md:h-[400px] md:w-[210px] lg:-left-2">
          <p class="ta-display text-[15px] font-semibold">{gettext("Bonjour, Hélène")}</p>
          <div class="flex flex-col gap-1.5 rounded-[10px] border-2 border-primary bg-base-100 p-2.5">
            <span class="font-mono text-[9px] font-semibold uppercase text-primary">
              {gettext("Maintenant · %{time}", time: "10:15")}
            </span>
            <span class="text-[13px] font-semibold">{gettext("Anglais · Niveau 2")}</span>
            <span class="grid h-[30px] place-items-center rounded-[7px] bg-primary text-[11px] font-semibold text-primary-content">
              {gettext("Faire l'appel")}
            </span>
          </div>
          <div
            :for={{time, name, status} <- lessons()}
            class="flex h-7 items-center gap-1.5 border-b border-base-300 text-[10.5px]"
          >
            <span class="ta-num ta-text-2 w-8 flex-none">{time}</span>
            <span class="flex-1 truncate">{name}</span>
            <span class={["ta-landing__chip", status == :done && "ta-landing__chip--done"]}>
              {if status == :done, do: gettext("Fait"), else: gettext("À venir")}
            </span>
          </div>
        </div>
      </div>
    </section>

    <%!-- PILOT --%>
    <section aria-label={gettext("Phase pilote")} class="border-y border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-5 text-sm sm:px-6 lg:flex-row lg:items-center lg:gap-10">
        <p>
          <span class="font-semibold">{gettext("Phase pilote 2026-2027")}</span>
          <span class="ta-text-2">· {gettext(
            "gratuite, tous les modules compris, installation accompagnée"
          )}</span>
        </p>
        <ul class="flex flex-wrap gap-1.5 lg:ml-auto" aria-label={gettext("Modules compris")}>
          <li
            :for={name <- pilot_modules()}
            class="rounded-full border border-base-300 px-2.5 py-1 font-mono text-xs font-medium"
          >
            {name}
          </li>
        </ul>
      </div>
    </section>

    <%!-- ONE SEQUENCE --%>
    <section
      id="sequence"
      aria-labelledby="sequence-title"
      class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 lg:py-22"
    >
      <p class="ta-landing__eyebrow">{gettext("Une séquence, de l'appel au bulletin")}</p>
      <h2
        id="sequence-title"
        class="mt-3 max-w-[45rem] text-[1.85rem] font-semibold leading-[1.15] sm:text-[2.4rem] [text-wrap:balance]"
      >
        {gettext("Chacun fait sa part une fois. Le reste de l'équipe la retrouve aussitôt.")}
      </h2>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
        <li
          :for={{step, n} <- Enum.with_index(sequence_steps(), 1)}
          class="flex flex-col gap-3 rounded-[14px] border border-base-300 bg-base-100 p-5"
        >
          <span class="flex items-center gap-2.5">
            <span class="ta-num grid size-[30px] place-items-center rounded-full bg-primary text-[13px] font-semibold text-primary-content">
              {n}
            </span>
            <span class="ta-text-2 text-[13px] font-semibold">{step.role}</span>
          </span>
          <h3 class="ta-landing__h3 text-[1.2rem] font-semibold leading-tight">{step.title}</h3>
          <p class="ta-landing__lead text-[0.92rem] leading-relaxed">{step.text}</p>
          <p class="mt-auto border-t border-base-300 pt-2.5 font-mono text-xs font-medium text-primary">
            {step.proof}
          </p>
        </li>
      </ol>
    </section>

    <%!-- BULLETINS --%>
    <section
      id="bulletins"
      aria-labelledby="bulletins-title"
      class="scroll-mt-20 border-y border-base-300 bg-base-100"
    >
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:py-20">
        <div class="max-w-xl">
          <p class="ta-landing__eyebrow">{gettext("Le soir du conseil de classe")}</p>
          <h2
            id="bulletins-title"
            class="mt-3 text-[1.85rem] font-semibold leading-[1.15] sm:text-[2.15rem] [text-wrap:balance]"
          >
            {gettext("Des bulletins prêts à imprimer, au format officiel.")}
          </h2>
          <p class="ta-landing__lead mt-4 leading-relaxed [text-wrap:pretty]">
            {gettext(
              "Moyennes, coefficients, rangs et appréciations se calculent à mesure que les notes arrivent. Le proviseur voit ce qui reste à régler classe par classe, tient le conseil, puis imprime toute la classe en une fois."
            )}
          </p>
          <.checks
            class="mt-5"
            items={[
              gettext("Lisible imprimé en noir et blanc"),
              gettext("Photo de l'élève et code QR de vérification"),
              gettext("Bulletins figés à la publication, enseignants prévenus")
            ]}
          />
        </div>

        <div aria-hidden="true" class="flex select-none justify-center py-2">
          <div class="ta-landing__sheet flex h-[350px] w-[300px] max-w-full flex-col gap-2 p-[18px]">
            <span class="ta-landing__flag block"></span>
            <span class="text-center text-[10px] font-bold uppercase tracking-wide">
              {gettext("Bulletin de notes · Trimestre 1")}
            </span>
            <span
              :for={{subject, coef, value} <- bulletin_rows()}
              class="ta-landing__sheet-rule flex gap-1.5 pb-[3px] text-[9.5px]"
            >
              <span class="flex-1">{subject}</span>
              <span class="ta-num w-6 text-right">{coef}</span>
              <span class="ta-num w-[2.15rem] text-right font-semibold">{mark(value)}</span>
            </span>
            <span class="mt-auto flex justify-between text-[10px] font-bold">
              <span>{gettext("Moyenne %{average}", average: mark(12.46))}</span>
              <span>{gettext("Rang 4e / 39")}</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <%!-- FEES --%>
    <section
      id="frais"
      aria-labelledby="frais-title"
      class="mx-auto grid max-w-6xl scroll-mt-20 items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:py-22"
    >
      <div aria-hidden="true" class="flex select-none justify-center py-2 max-lg:order-last">
        <div class="ta-landing__sheet ta-landing__sheet--tilt-right flex w-[300px] max-w-full flex-col gap-2 p-[18px] text-[10px]">
          <span class="ta-landing__flag block"></span>
          <span class="flex items-baseline justify-between gap-2">
            <span class="text-[11px] font-bold uppercase tracking-wide">{gettext("Reçu")}</span>
            <span class="ta-num font-semibold">R2026-000123</span>
          </span>
          <span class="ta-landing__sheet-rule flex justify-between pb-[3px]">
            <span>{gettext("Élève")}</span>
            <span class="font-semibold">Ngo Bassa Marie</span>
          </span>
          <span class="ta-landing__sheet-rule flex justify-between pb-[3px]">
            <span>{gettext("Classe")}</span>
            <span class="font-semibold">{gettext("2nde C")}</span>
          </span>
          <span
            :for={{label, amount} <- receipt_rows()}
            class="ta-landing__sheet-rule flex justify-between pb-[3px]"
          >
            <span>{label}</span>
            <span class="ta-num">{fcfa(amount)}</span>
          </span>
          <span class="flex justify-between text-[11px] font-bold">
            <span>{gettext("Ce reçu")}</span>
            <span class="ta-num">{fcfa(35_000)}</span>
          </span>
          <span class="mt-2 flex items-end justify-between gap-3">
            <span class="flex flex-col gap-1">
              <span :for={{label, amount} <- receipt_totals()} class="flex gap-2">
                <span>{label}</span>
                <span class="ta-num font-semibold">{fcfa(amount)}</span>
              </span>
            </span>
            <span class="grid size-14 flex-none grid-cols-7 gap-px">
              <span :for={dark <- qr_cells()} class={dark && "bg-[#17231E]"}></span>
            </span>
          </span>
        </div>
      </div>

      <div class="max-w-xl">
        <p class="ta-landing__eyebrow">{gettext("À l'intendance")}</p>
        <h2
          id="frais-title"
          class="mt-3 text-[1.85rem] font-semibold leading-[1.15] sm:text-[2.15rem] [text-wrap:balance]"
        >
          {gettext("Chaque franc encaissé a son reçu, et chaque reçu se vérifie.")}
        </h2>
        <p class="ta-landing__lead mt-4 leading-relaxed [text-wrap:pretty]">
          {gettext(
            "L'établissement fixe ses frais, les montants par niveau et les tranches avec leurs échéances. Chaque paiement donne un reçu numéroté qui ne se modifie plus, et l'intendant voit classe par classe qui est à jour et qui est en retard."
          )}
        </p>
        <.checks
          class="mt-5"
          items={[
            gettext("Reçus vérifiables en ligne, par code QR ou par numéro"),
            gettext("Résumé du reçu envoyé aux parents par WhatsApp"),
            gettext("Liste de contrôle par classe, lettres d'avertissement et bons de retour"),
            gettext(
              "Un élève renvoyé pour frais est noté comme tel à l'appel, sans compter d'absence"
            )
          ]}
        />
      </div>
    </section>

    <%!-- EVERYTHING INCLUDED --%>
    <section
      id="inclus"
      aria-labelledby="inclus-title"
      class="scroll-mt-20 border-y border-base-300 bg-base-100"
    >
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
        <p class="ta-landing__eyebrow">{gettext("Tout ce qui est inclus")}</p>
        <h2
          id="inclus-title"
          class="mt-3 max-w-[42rem] text-[1.85rem] font-semibold leading-[1.15] sm:text-[2.15rem] [text-wrap:balance]"
        >
          {gettext("Toute la vie de l'établissement, dans une seule application.")}
        </h2>
        <ul class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
          <li :for={module <- modules()} class="flex gap-3.5 sm:flex-col sm:gap-3">
            <span class="grid size-10 flex-none place-items-center rounded-xl bg-primary/12 text-primary">
              <.icon name={module.icon} class="size-5" />
            </span>
            <div>
              <h3 class="ta-landing__h3 text-base font-semibold">{module.title}</h3>
              <p class="ta-landing__lead mt-1 text-[0.92rem] leading-relaxed">{module.text}</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <%!-- ROLES --%>
    <section
      id="roles"
      aria-labelledby="roles-title"
      class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 lg:py-22"
    >
      <p class="ta-landing__eyebrow">{gettext("Un espace par rôle")}</p>
      <h2
        id="roles-title"
        class="mt-3 max-w-[42rem] text-[1.85rem] font-semibold leading-[1.15] sm:text-[2.15rem] [text-wrap:balance]"
      >
        {gettext("Chacun ouvre l'application sur ce qu'il a à faire aujourd'hui.")}
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article
          :for={role <- roles()}
          class="flex flex-col gap-2.5 rounded-[14px] border border-base-300 p-5 transition-colors hover:border-[var(--ta-rule-strong)]"
        >
          <h3 class="ta-landing__h3 text-[1.07rem] font-semibold">{role.title}</h3>
          <p class="ta-landing__lead text-sm leading-relaxed">{role.text}</p>
          <p class="ta-text-2 mt-auto pt-2 font-mono text-xs font-medium">
            <span class="sr-only">{gettext("Ses pages principales :")}</span>
            {Enum.join(role.tabs, " · ")}
          </p>
        </article>
      </div>
    </section>

    <%!-- GETTING STARTED + PRICE --%>
    <section
      id="tarif"
      aria-labelledby="tarif-title"
      class="scroll-mt-20 border-t border-base-300 bg-base-100"
    >
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:py-20">
        <div>
          <p class="ta-landing__eyebrow">{gettext("Démarrer")}</p>
          <h2
            id="tarif-title"
            class="mt-3 text-[1.85rem] font-semibold leading-[1.15] sm:text-[2.15rem] [text-wrap:balance]"
          >
            {gettext("Prêt pour la prochaine séquence en trois étapes.")}
          </h2>
          <ol class="mt-7 flex flex-col gap-5">
            <li :for={{step, n} <- Enum.with_index(start_steps(), 1)} class="flex gap-3.5">
              <span class="ta-num grid size-[30px] flex-none place-items-center rounded-full border border-primary text-[13px] font-semibold text-primary">
                {n}
              </span>
              <div>
                <h3 class="ta-landing__h3 text-base font-semibold">{step.title}</h3>
                <p class="ta-landing__lead mt-1 text-[0.92rem] leading-relaxed">{step.text}</p>
              </div>
            </li>
          </ol>
        </div>

        <div class="ta-landing__strong-rule flex flex-col gap-3.5 self-start rounded-2xl border bg-base-200 p-6 sm:p-7">
          <p class="ta-landing__eyebrow">{gettext("Tarif")}</p>
          <h3 class="text-[1.85rem] font-semibold leading-tight">
            {gettext("Gratuit pendant la phase pilote")}
          </h3>
          <p class="ta-landing__lead leading-relaxed">
            {gettext(
              "Tous les modules et tous les rôles, pour tout l'établissement, avec une installation accompagnée. Le tarif par élève et par an sera annoncé avant la rentrée."
            )}
          </p>
          <.link
            href={~p"/schools/start"}
            class="btn btn-primary btn-lg mt-1.5 min-h-12 w-full sm:w-auto sm:self-start"
          >
            {gettext("Inscrire mon établissement")}
            <.icon name="hero-arrow-right" class="size-5" />
          </.link>
          <.contact_line class="mt-1" />
        </div>
      </div>
    </section>

    <%!-- FAQ --%>
    <section
      id="questions"
      aria-labelledby="questions-title"
      class="mx-auto w-full max-w-3xl scroll-mt-20 px-4 py-16 sm:px-6 lg:py-20"
    >
      <h2 id="questions-title" class="text-[1.85rem] font-semibold">
        {gettext("Questions fréquentes")}
      </h2>
      <div class="mt-5 border-t border-base-300">
        <details :for={{q, a} <- faq()} class="group border-b border-base-300">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold">
            {q}
            <.icon
              name="hero-chevron-down"
              class="size-5 flex-none transition-transform group-open:rotate-180 motion-reduce:transition-none"
            />
          </summary>
          <p class="ta-landing__lead pb-5 leading-relaxed">{a}</p>
        </details>
      </div>
    </section>

    <%!-- CLOSING CTA --%>
    <section aria-labelledby="closing-title" class="border-t border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-12 sm:px-6 lg:flex-row lg:items-center">
        <div class="flex-1">
          <h2
            id="closing-title"
            class="text-[1.6rem] font-semibold leading-tight [text-wrap:balance]"
          >
            {gettext("Votre établissement, prêt pour la prochaine séquence.")}
          </h2>
          <.contact_line class="mt-2" />
        </div>
        <div class="flex flex-col gap-2.5 sm:flex-row sm:gap-3">
          <.link href={~p"/schools/start"} class="btn btn-primary btn-lg min-h-12">
            {gettext("Inscrire mon établissement")}
          </.link>
          <.link
            :if={@current_user}
            href={~p"/school"}
            class="btn btn-outline btn-lg ta-landing__strong-rule min-h-12"
          >
            {gettext("Mon espace")}
          </.link>
          <.link
            :if={!@current_user}
            href={~p"/sign-in"}
            class="btn btn-outline btn-lg ta-landing__strong-rule min-h-12"
          >
            {gettext("Se connecter")}
          </.link>
        </div>
      </div>
    </section>
  </main>

  <.site_footer current_user={@current_user} />
</div>
