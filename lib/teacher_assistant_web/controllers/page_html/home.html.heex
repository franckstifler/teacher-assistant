<Layouts.app flash={@flash} current_scope={assigns[:current_scope]}>
  <%!-- ============================ HERO ============================ --%>
  <section id="landing-hero" class="relative overflow-hidden border-b border-base-300">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:py-20">
      <div>
        <p class="ta-eyebrow">Cameroon secondary schools · APC / CBA</p>

        <h1 class="mt-4 font-display text-4xl font-semibold leading-[1.05] sm:text-5xl">
          Run the whole établissement
          from one chalkboard.
        </h1>

        <p class="mt-5 max-w-xl text-base leading-7 text-base-content/75">
          Set up your school, bring your teachers in, and let every class take the <span class="font-semibold text-base-content">appel</span>, enter marks, and build
          bulletins in the same place. How much of the programme has been covered stays visible all
          year — on any phone, in French or English.
        </p>

        <div id="home-actions" class="mt-8 flex flex-col gap-3 sm:flex-row">
          <.link navigate={~p"/register"} class="btn btn-primary btn-lg">
            <.icon name="hero-building-office-2" class="size-5" /> Create your school
          </.link>
          <.link href="#teacher-lane" class="btn btn-outline btn-lg">
            <.icon name="hero-academic-cap" class="size-5" /> I just teach my own classes
          </.link>
        </div>

        <p class="mt-4 text-sm text-base-content/55">
          Already have an account?
          <.link navigate={~p"/sign-in"} class="link link-hover font-semibold text-info">
            Sign in
          </.link>
        </p>
      </div>

      <%!-- The one bold element: a head teacher's morning glance --%>
      <div class="ta-board p-5 sm:p-6">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="ta-display truncate text-sm font-semibold">
              Lycée Bilingue de Bafoussam
            </div>
            <div class="mt-1 flex items-center gap-1.5 text-[0.7rem] text-base-content/60">
              <.icon name="hero-shield-check" class="size-3.5 text-primary" />
              <span>Verified · Trimestre 1</span>
            </div>
          </div>
          <span class="ta-num rounded-full border border-base-300 px-3 py-1 text-xs font-semibold text-base-content/70">
            Séq 2
          </span>
        </div>

        <div class="mt-5 space-y-4">
          <div>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <span class="text-sm font-semibold">6e A · Mathématiques</span>
              <span class="inline-flex items-center gap-1 text-[0.7rem] font-semibold text-primary">
                <.icon name="hero-check-circle" class="size-3.5" /> Appel fait · 42/42
              </span>
            </div>
            <.coverage_ribbon rate={64} />
          </div>
          <div>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <span class="text-sm font-semibold">5e B · Français</span>
              <span class="inline-flex items-center gap-1 text-[0.7rem] font-semibold text-secondary">
                <.icon name="hero-pencil-square" class="size-3.5" /> Notes · séq 3/5
              </span>
            </div>
            <.coverage_ribbon rate={49} behind?={true} />
          </div>
        </div>

        <div class="mt-5 grid grid-cols-3 gap-2 border-t border-base-300 pt-4 text-center">
          <div>
            <div class="ta-num text-lg font-semibold">18</div>
            <div class="text-[0.65rem] text-base-content/55">classes</div>
          </div>
          <div>
            <div class="ta-num text-lg font-semibold">96%</div>
            <div class="text-[0.65rem] text-base-content/55">appel du jour</div>
          </div>
          <div>
            <div class="ta-num text-lg font-semibold">7</div>
            <div class="text-[0.65rem] text-base-content/55">bulletins prêts</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ============================ TWO LANES ============================ --%>
  <section id="landing-lanes" class="border-b border-base-300 bg-base-100">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="ta-eyebrow">Two ways in</p>
      <h2 class="mt-3 max-w-2xl font-display text-2xl font-semibold leading-snug sm:text-3xl">
        Built for a whole school — and for the teacher working alone.
      </h2>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <%!-- School lane: green accent, filled primary CTA --%>
        <div
          id="school-lane"
          class="flex flex-col rounded-box border border-base-300 bg-base-200 p-6"
        >
          <div class="flex items-center gap-2 text-primary">
            <.icon name="hero-building-office-2" class="size-5" />
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em]">
              For your school
            </span>
          </div>
          <h3 class="mt-3 font-display text-xl font-semibold">
            One place your whole staff works from
          </h3>
          <p class="mt-3 text-sm leading-6 text-base-content/75">
            Register the établissement once — type, subsystem, region — then invite your teachers
            and give each a role. Every class takes the appel, records marks, and prints bulletins
            the same way, and you watch coverage across the school at a glance.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-base-content/80">
            <li class="flex items-start gap-2">
              <.icon name="hero-check" class="mt-0.5 size-4 shrink-0 text-primary" />
              Roll call, marks and bulletins for every class
            </li>
            <li class="flex items-start gap-2">
              <.icon name="hero-check" class="mt-0.5 size-4 shrink-0 text-primary" />
              Teachers you invite, roles you decide
            </li>
            <li class="flex items-start gap-2">
              <.icon name="hero-check" class="mt-0.5 size-4 shrink-0 text-primary" />
              Coverage of the programme, school-wide
            </li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <.link navigate={~p"/schools/new"} class="btn btn-primary">
              Create your school
            </.link>
            <.link href="#start" class="btn btn-ghost">
              How it works
            </.link>
          </div>
        </div>

        <%!-- Teacher lane: sky accent, outline CTA --%>
        <div
          id="teacher-lane"
          class="flex flex-col rounded-box border border-base-300 bg-base-200 p-6"
        >
          <div class="flex items-center gap-2 text-info">
            <.icon name="hero-academic-cap" class="size-5" />
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em]">
              For your own classes
            </span>
          </div>
          <h3 class="mt-3 font-display text-xl font-semibold">
            Follow your own teaching, with or without a school
          </h3>
          <p class="mt-3 text-sm leading-6 text-base-content/75">
            Build your fiche de progression once, tick off what you cover each week, and watch your
            <span class="ta-mark font-semibold">taux de couverture</span>
            climb. It works entirely on its own — join a school later and nothing you logged is lost.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-base-content/80">
            <li class="flex items-start gap-2">
              <.icon name="hero-check" class="mt-0.5 size-4 shrink-0 text-info" />
              Your fiche de progression, six sequences a year
            </li>
            <li class="flex items-start gap-2">
              <.icon name="hero-check" class="mt-0.5 size-4 shrink-0 text-info" />
              A living cahier de textes you can print
            </li>
            <li class="flex items-start gap-2">
              <.icon name="hero-check" class="mt-0.5 size-4 shrink-0 text-info" />
              Your marks and averages, séquence by séquence
            </li>
          </ul>
          <div class="mt-6">
            <.link navigate={~p"/register"} class="btn btn-outline">
              Track my own classes
            </.link>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ============================ WHAT THE SCHOOL RUNS ============================ --%>
  <section id="landing-features" class="border-b border-base-300">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="ta-eyebrow">What the school runs</p>
      <h2 class="mt-3 max-w-2xl font-display text-2xl font-semibold leading-snug sm:text-3xl">
        Everything a term needs, in the teachers' hands.
      </h2>

      <%!-- ledger grid: 1px chalk-dust rules between cells, no floating cards --%>
      <div class="mt-8 grid gap-px overflow-hidden rounded-box border border-base-300 bg-base-300 sm:grid-cols-2 lg:grid-cols-3">
        <div class="bg-base-100 p-6">
          <.icon name="hero-identification" class="size-6 text-primary" />
          <h3 class="mt-3 text-base font-semibold">Set up the établissement</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Name, type — Lycée, CES, CETIC — subsystem, region and logo. Your school's real
            identity, not a blank tenant.
          </p>
        </div>
        <div class="bg-base-100 p-6">
          <.icon name="hero-user-group" class="size-6 text-primary" />
          <h3 class="mt-3 text-base font-semibold">Invite staff, assign roles</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Bring your teachers into the school and decide what each one can do. The head configures;
            teachers record.
          </p>
        </div>
        <div class="bg-base-100 p-6">
          <.icon name="hero-clipboard-document-check" class="size-6 text-primary" />
          <h3 class="mt-3 text-base font-semibold">Roll call in one tap</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Everyone starts present — mark only the absent and the late. The appel for a full class
            takes seconds.
          </p>
        </div>
        <div class="bg-base-100 p-6">
          <.icon name="hero-pencil-square" class="size-6 text-primary" />
          <h3 class="mt-3 text-base font-semibold">Marks by every teacher</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Each teacher enters their own notes, séquence by séquence, on any phone. Scores that fall
            out of range are caught as you type.
          </p>
        </div>
        <div class="bg-base-100 p-6">
          <.icon name="hero-document-text" class="size-6 text-primary" />
          <h3 class="mt-3 text-base font-semibold">Bulletins per class</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Averages and report cards come together from the marks already entered — ready to print
            for a student or a whole class.
          </p>
        </div>
        <div class="bg-base-100 p-6">
          <.icon name="hero-shield-check" class="size-6 text-primary" />
          <h3 class="mt-3 text-base font-semibold">Verified before you operate</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Set everything up for free straight away. Recording marks and attendance unlocks once
            your school is verified — so records are trustworthy from day one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ============================ GETTING STARTED (a real sequence) ============================ --%>
  <section id="start" class="border-b border-base-300 bg-base-100">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <p class="ta-eyebrow">Getting started</p>
      <h2 class="mt-3 max-w-2xl font-display text-2xl font-semibold leading-snug sm:text-3xl">
        From nothing to your first appel in an afternoon.
      </h2>

      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <li class="border-t-2 border-base-300 pt-4">
          <span class="ta-num grid size-9 place-items-center rounded-full border border-primary/40 text-sm font-semibold text-primary">
            1
          </span>
          <h3 class="mt-3 text-base font-semibold">Create your school</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Name it, pick the type and subsystem. Free, and it takes a minute.
          </p>
        </li>
        <li class="border-t-2 border-base-300 pt-4">
          <span class="ta-num grid size-9 place-items-center rounded-full border border-primary/40 text-sm font-semibold text-primary">
            2
          </span>
          <h3 class="mt-3 text-base font-semibold">Add classes and staff</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Set up your classes, invite teachers, and give each one their role.
          </p>
        </li>
        <li class="border-t-2 border-base-300 pt-4">
          <span class="ta-num grid size-9 place-items-center rounded-full border border-primary/40 text-sm font-semibold text-primary">
            3
          </span>
          <h3 class="mt-3 text-base font-semibold">Get verified</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            We confirm the school. Setup stays fully open while you wait.
          </p>
        </li>
        <li class="border-t-2 border-base-300 pt-4">
          <span class="ta-num grid size-9 place-items-center rounded-full border border-primary/40 text-sm font-semibold text-primary">
            4
          </span>
          <h3 class="mt-3 text-base font-semibold">Start recording</h3>
          <p class="mt-1.5 text-sm leading-6 text-base-content/70">
            Appel, marks and bulletins are live for every class and every teacher.
          </p>
        </li>
      </ol>

      <div class="mt-8">
        <.link navigate={~p"/schools/new"} class="btn btn-primary btn-lg">
          <.icon name="hero-building-office-2" class="size-5" /> Create your school
        </.link>
      </div>
    </div>
  </section>

  <%!-- ============================ CLASSROOM REALITY BAND ============================ --%>
  <section id="landing-reality" class="border-b border-base-300">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 sm:grid-cols-3">
      <div>
        <.icon name="hero-device-phone-mobile" class="size-6 text-base-content/70" />
        <h3 class="mt-3 text-base font-semibold">Made for the phone in your hand</h3>
        <p class="mt-1.5 text-sm leading-6 text-base-content/70">
          Quick, forgiving taps built for a smartphone on a patchy connection — your work is never
          lost to a dropped request.
        </p>
      </div>
      <div>
        <.icon name="hero-language" class="size-6 text-base-content/70" />
        <h3 class="mt-3 text-base font-semibold">Bilingual by design</h3>
        <p class="mt-1.5 text-sm leading-6 text-base-content/70">
          Francophone and Anglophone subsystems, French or English interface — switch any time. One
          national system, two tracks.
        </p>
      </div>
      <div>
        <.icon name="hero-lock-closed" class="size-6 text-base-content/70" />
        <h3 class="mt-3 text-base font-semibold">Your school's records, kept safe</h3>
        <p class="mt-1.5 text-sm leading-6 text-base-content/70">
          Marks and attendance stay inside your school, visible only to the staff you invite.
        </p>
      </div>
    </div>
  </section>

  <%!-- ============================ FINAL CTA ============================ --%>
  <section id="landing-cta" class="bg-base-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="ta-board flex flex-col items-start gap-6 p-8 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">
            Set your school up today.
          </h2>
          <p class="mt-2 max-w-xl text-sm leading-6 text-base-content/70">
            Create the établissement on the bus home, invite your teachers tonight, and take the
            first appel tomorrow morning.
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <.link navigate={~p"/register"} class="btn btn-primary btn-lg">
            Create your school
          </.link>
          <.link navigate={~p"/sign-in"} class="btn btn-outline btn-lg">
            Sign in
          </.link>
        </div>
      </div>
    </div>
  </section>

  <%!-- ============================ FOOTER (every link the front door needs) ============================ --%>
  <footer class="border-t border-base-300 bg-base-100">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div class="grid gap-8 sm:grid-cols-3">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="grid size-9 place-items-center rounded-lg bg-primary text-primary-content shadow-sm">
              <.icon name="hero-academic-cap" class="size-5" />
            </span>
            <span class="ta-display text-sm font-semibold">Teacher Assistant</span>
          </div>
          <p class="mt-3 max-w-xs text-sm leading-6 text-base-content/60">
            The chalkboard for Cameroon secondary schools — appel, marks, bulletins and programme
            coverage, in French and English.
          </p>
        </div>

        <nav aria-label="Get started">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-base-content/50">
            Get started
          </p>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <.link navigate={~p"/schools/new"} class="link link-hover">
                Create your school
              </.link>
            </li>
            <li>
              <.link navigate={~p"/register"} class="link link-hover">Create an account</.link>
            </li>
            <li>
              <.link navigate={~p"/sign-in"} class="link link-hover">Sign in</.link>
            </li>
          </ul>
        </nav>

        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-base-content/50">
            Language
          </p>
          <div class="mt-3 flex items-center gap-1 text-sm">
            <.link navigate={~p"/locale/fr"} class="btn btn-ghost btn-sm ta-num">Français</.link>
            <span class="text-base-content/30">·</span>
            <.link navigate={~p"/locale/en"} class="btn btn-ghost btn-sm ta-num">English</.link>
          </div>
          <p class="mt-4 text-xs leading-5 text-base-content/50">
            APC / CBA · Francophone &amp; Anglophone subsystems
          </p>
        </div>
      </div>

      <div class="mt-8 border-t border-base-300 pt-6 text-xs text-base-content/50">
        © 2026 Teacher Assistant · Built for Cameroon secondary schools
      </div>
    </div>
  </footer>
</Layouts.app>
