<Layouts.app flash={@flash} current_scope={assigns[:current_scope]}>
  <section id="home-overview" class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
    <div class="space-y-6">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">
          Cameroon secondary school operations
        </p>
        <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-tight text-base-content sm:text-5xl">
          Teacher Assistant
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-base-content/70">
          Configure the school year, assign classes and subjects, track attendance and marks, then follow programme coverage from weekly progression plans.
        </p>
      </div>

      <div id="home-actions" class="flex flex-col gap-3 sm:flex-row">
        <.link navigate={~p"/teacher/attendance"} class="btn btn-primary">
          <.icon name="hero-clipboard-document-check" class="size-5" /> Attendance
        </.link>
        <.link navigate={~p"/teacher/marks"} class="btn btn-outline">
          <.icon name="hero-pencil-square" class="size-5" /> Marks
        </.link>
        <.link navigate={~p"/configurations/academic_years"} class="btn btn-ghost">
          <.icon name="hero-calendar-days" class="size-5" /> School year
        </.link>
      </div>

      <div
        id="home-workflows"
        class="overflow-x-auto rounded-md border border-base-300 bg-base-100"
      >
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Role</th>
              <th>Primary work</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-medium">Admin</td>
              <td>Academic years, classes, students, subjects, assignments</td>
              <td><span class="badge badge-success badge-sm">Foundation</span></td>
            </tr>
            <tr>
              <td class="font-medium">Teacher</td>
              <td>Marks, attendance, teaching logs, APC lesson structures</td>
              <td><span class="badge badge-warning badge-sm">In progress</span></td>
            </tr>
            <tr>
              <td class="font-medium">Vice principal</td>
              <td>Programme coverage and yearly progression reports</td>
              <td><span class="badge badge-outline badge-sm">Planned</span></td>
            </tr>
            <tr>
              <td class="font-medium">Accountant</td>
              <td>Classroom access status for enrolled students</td>
              <td><span class="badge badge-warning badge-sm">Foundation</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <aside
      id="home-readiness-panel"
      class="rounded-md border border-base-300 bg-base-100 p-5 shadow-sm"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold">Foundation Checklist</h2>
          <p class="mt-1 text-sm text-base-content/60">
            Core workflows needed before printable reports and AI suggestions.
          </p>
        </div>
        <Layouts.theme_toggle />
      </div>

      <div class="divider my-4"></div>

      <ul class="space-y-3 text-sm">
        <li class="flex items-center gap-3">
          <.icon name="hero-check-circle" class="size-5 text-success" />
          Real school scope and membership
        </li>
        <li class="flex items-center gap-3">
          <.icon name="hero-check-circle" class="size-5 text-success" />
          Deterministic mark and report-card calculations
        </li>
        <li class="flex items-center gap-3">
          <.icon name="hero-check-circle" class="size-5 text-success" />
          Duplicate-safe attendance records
        </li>
        <li class="flex items-center gap-3">
          <.icon name="hero-clock" class="size-5 text-warning" />
          Progression import review screens
        </li>
        <li class="flex items-center gap-3">
          <.icon name="hero-clock" class="size-5 text-warning" /> Coverage dashboards by role
        </li>
      </ul>
    </aside>
  </section>
</Layouts.app>
