<%!--
  Landing (UI review 2026-10): schools only, in the app's « Tableau, affiné » look
  (daisyUI tokens, so it follows the visitor's theme). Rendered on the root layout
  with its own header and footer. Screens are captures of the demo school,
  renamed « Lycée de démonstration »; data lists live in PageHTML.
--%>
<div class="ta-landing flex min-h-screen flex-col bg-base-200 text-base-content">
  <a
    href="#contenu"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-base-100 focus:px-4 focus:py-3"
  >
    {gettext("Aller au contenu")}
  </a>

  <header class="sticky top-0 z-30 border-b border-base-300 bg-base-200/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2 sm:px-6">
      <a href={~p"/"} class="flex min-h-11 items-center gap-2.5">
        <span class="grid size-8 place-items-center rounded-lg bg-primary text-sm font-bold text-primary-content ta-display">
          TA
        </span>
        <span class="text-[0.95rem] font-semibold">Teacher Assistant</span>
      </a>
      <nav class="ml-6 hidden items-center gap-1 lg:flex" aria-label={gettext("Sections")}>
        <a href="#journee" class="ta-landing__nav">{gettext("Fonctionnalités")}</a>
        <a href="#roles" class="ta-landing__nav">{gettext("Rôles")}</a>
        <a href="#terrain" class="ta-landing__nav">{gettext("Cameroun")}</a>
        <a href="#tarif" class="ta-landing__nav">{gettext("Tarif")}</a>
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <div class="hidden items-center md:flex" aria-label={gettext("Langue")}>
          <.link href={~p"/locale/fr"} class="ta-landing__nav !px-2">FR</.link>
          <span class="ta-text-2" aria-hidden="true">·</span>
          <.link href={~p"/locale/en"} class="ta-landing__nav !px-2">EN</.link>
        </div>
        <.link href={~p"/sign-in"} class="btn btn-ghost min-h-11 px-3">
          {gettext("Se connecter")}
        </.link>
        <.link href={~p"/schools/start"} class="btn btn-primary hidden min-h-11 sm:inline-flex">
          {gettext("Inscrire mon établissement")}
        </.link>
      </div>
    </div>
  </header>

  <main id="contenu" class="flex-1">
    <%!-- HERO --%>
    <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-14 pt-10 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:pb-24 lg:pt-16">
      <div>
        <p class="ta-eyebrow">{gettext("Lycées et collèges du Cameroun")}</p>
        <h1 class="mt-3 text-[2.35rem] font-semibold leading-[1.05] tracking-[-0.015em] sm:text-5xl lg:text-[3.4rem] [text-wrap:balance]">
          {gettext("Tout l'établissement sur un seul tableau.")}
        </h1>
        <p class="ta-text-2 mt-5 max-w-xl text-[1.07rem] leading-relaxed [text-wrap:pretty]">
          {gettext(
            "L'appel, les notes, les bulletins, les emplois du temps et la vie scolaire au même endroit. Chaque membre de l'équipe a son espace, sur téléphone comme sur ordinateur."
          )}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <.link href={~p"/schools/start"} class="btn btn-primary btn-lg min-h-12">
            {gettext("Inscrire mon établissement")}
            <.icon name="hero-arrow-right" class="size-5" />
          </.link>
          <a href="#journee" class="btn btn-outline btn-lg min-h-12">
            {gettext("Voir comment ça marche")}
          </a>
        </div>
        <p class="ta-text-2 mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <span class="inline-flex items-center gap-1.5">
            <.icon name="hero-check" class="size-4 text-primary" />{gettext(
              "Francophone et anglophone"
            )}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <.icon name="hero-check" class="size-4 text-primary" />{gettext(
              "Gratuit pendant la phase pilote"
            )}
          </span>
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-md sm:mb-14 sm:max-w-2xl lg:mb-0 lg:max-w-none">
        <div class="hidden sm:block">
          <.window_shot
            src="/images/landing/dash-desktop.webp"
            alt={
              gettext(
                "Le tableau de bord du proviseur : saisie des notes, appels du jour, absences à justifier, tâches à traiter"
              )
            }
            class="ta-only-dark sm:ml-16 lg:ml-12"
            from={:sm}
            eager
          />
          <.window_shot
            src="/images/landing/dash-desktop-light.webp"
            alt={
              gettext(
                "Le tableau de bord du proviseur : saisie des notes, appels du jour, absences à justifier, tâches à traiter"
              )
            }
            class="ta-only-light sm:ml-16 lg:ml-12"
            from={:sm}
            eager
          />
        </div>
        <.phone_shot
          src="/images/landing/dash-phone.webp"
          alt={gettext("L'accueil du proviseur sur téléphone")}
          class="mx-auto w-[min(17rem,78vw)] sm:absolute sm:-bottom-14 sm:left-0 sm:w-[9.5rem] lg:-left-4 lg:w-[10.5rem]"
          eager
        />
      </div>
    </section>

    <%!-- ROLE STRIP --%>
    <div class="border-y border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4 text-sm sm:px-6">
        <span class="ta-text-2">{gettext("Un espace pour chacun :")}</span>
        <span
          :for={r <- roles()}
          class="inline-flex items-center gap-2 font-medium"
        >
          <.icon name={r.icon} class="size-4 text-primary" />{r.title}
        </span>
      </div>
    </div>

    <%!-- A SCHOOL DAY, ROLE BY ROLE --%>
    <section id="journee" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 lg:py-24">
      <div class="max-w-2xl">
        <p class="ta-eyebrow">{gettext("Une journée au lycée")}</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.01em] sm:text-4xl [text-wrap:balance]">
          {gettext("Chacun fait sa part, et tout le monde la voit.")}
        </h2>
        <p class="ta-text-2 mt-4 text-[1.02rem] leading-relaxed [text-wrap:pretty]">
          {gettext(
            "Personne ne ressaisit le travail d'un autre : l'appel de l'enseignant nourrit la journée du surveillant général, ses notes nourrissent le suivi du censeur et les bulletins."
          )}
        </p>
      </div>

      <div class="mt-14 flex flex-col gap-20 lg:gap-28">
        <article
          :for={{step, i} <- Enum.with_index(day_steps())}
          id={"journee-#{step.id}"}
          class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16"
        >
          <div class={["max-w-xl", rem(i, 2) == 1 && "lg:order-2"]}>
            <p class="flex items-center gap-3 text-sm">
              <span class="ta-num rounded-full bg-base-100 px-2.5 py-1 text-[0.8rem] font-medium ring-1 ring-base-300">
                {step.time}
              </span>
              <span class="ta-text-2 font-medium">{step.role}</span>
            </p>
            <h3 class="mt-4 text-2xl font-semibold leading-tight sm:text-[1.75rem] [text-wrap:balance]">
              {step.title}
            </h3>
            <p class="ta-text-2 mt-3 text-[1.02rem] leading-relaxed [text-wrap:pretty]">
              {step.text}
            </p>
            <.checks items={step.points} />
          </div>
          <div class={[
            "flex items-start justify-center gap-4 sm:gap-6",
            rem(i, 2) == 1 && "lg:order-1"
          ]}>
            <.phone_shot
              :for={{{src, alt}, j} <- Enum.with_index(step.shots)}
              src={src}
              alt={alt}
              class={
                if(j == 0,
                  do: "w-[min(16.5rem,70vw)]",
                  else: "hidden w-[14rem] translate-y-10 sm:block"
                )
              }
            />
          </div>
        </article>
      </div>
    </section>

    <%!-- BULLETINS --%>
    <section id="bulletins" class="scroll-mt-20 border-y border-base-300 bg-base-100">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:py-24">
        <div class="max-w-xl">
          <p class="flex items-center gap-3 text-sm">
            <span class="ta-text-2 font-medium">{gettext("Proviseur et censeur")}</span>
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.01em] sm:text-4xl [text-wrap:balance]">
            {gettext("Des bulletins prêts le jour du conseil de classe")}
          </h2>
          <p class="ta-text-2 mt-4 text-[1.02rem] leading-relaxed [text-wrap:pretty]">
            {gettext(
              "Coefficients, moyennes, rangs, appréciations et distinctions se calculent à mesure que les notes arrivent. On voit ce qui manque encore, on tient le conseil de classe, on publie, puis on imprime toute la classe."
            )}
          </p>
          <.checks items={[
            gettext("Format officiel, lisible imprimé en noir et blanc"),
            gettext("Photo de l'élève et code QR pour vérifier un bulletin"),
            gettext("Bulletins figés une fois publiés, prévenus par notification")
          ]} />
        </div>
        <div class="relative">
          <.window_shot
            src="/images/landing/bulletins-desktop.webp"
            alt={
              gettext(
                "Les bulletins du trimestre 1 de la 6e A : ce qui manque, le classement et le détail d'une élève"
              )
            }
            class="hidden md:block"
            from={:md}
          />
          <div class="ta-paper mx-auto w-[min(21rem,88vw)] md:absolute md:-bottom-10 md:right-3 md:w-[42%] lg:-right-4">
            <img
              src="/images/landing/bulletin-print.webp"
              alt={gettext("Un bulletin de notes imprimé, au format officiel")}
              width="1200"
              height="1467"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <%!-- ROLES --%>
    <section id="roles" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 lg:py-24">
      <div class="max-w-2xl">
        <p class="ta-eyebrow">{gettext("Chaque rôle a son espace")}</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.01em] sm:text-4xl [text-wrap:balance]">
          {gettext("Un compte par personne, l'écran qui va avec son rôle.")}
        </h2>
        <p class="ta-text-2 mt-4 text-[1.02rem] leading-relaxed [text-wrap:pretty]">
          {gettext(
            "Sur téléphone, chacun retrouve en bas de l'écran les quatre pages dont il se sert le plus. Celui qui a deux rôles passe de l'un à l'autre en un geste."
          )}
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div :for={r <- roles()} class="ta-panel flex flex-col gap-3 !p-5">
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-primary/15 text-primary">
              <.icon name={r.icon} class="size-5" />
            </span>
            <h3 class="text-lg font-semibold">{r.title}</h3>
          </div>
          <p class="ta-text-2 leading-relaxed">{r.text}</p>
          <ul class="mt-1 flex flex-wrap gap-1.5" aria-label={gettext("Ses pages principales")}>
            <li
              :for={tab <- r.tabs}
              class="rounded-full bg-base-200 px-3 py-1 text-sm font-medium ring-1 ring-base-300"
            >
              {tab}
            </li>
          </ul>
        </div>
      </div>
    </section>

    <%!-- AND ALSO --%>
    <section class="border-y border-base-300 bg-base-100">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
        <h2 class="text-2xl font-semibold tracking-[-0.01em] sm:text-3xl">
          {gettext("Et tout le reste de l'année scolaire")}
        </h2>
        <div class="mt-8 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
          <div :for={f <- more_features()} class="flex flex-col gap-2">
            <.icon name={f.icon} class="size-6 text-primary" />
            <h3 class="text-base font-semibold">{f.title}</h3>
            <p class="ta-text-2 text-[0.95rem] leading-relaxed">{f.text}</p>
          </div>
        </div>
        <div class="mt-12 hidden sm:block">
          <.window_shot
            src="/images/landing/timetable-desktop.webp"
            alt={
              gettext(
                "L'éditeur d'emploi du temps de la 6e A, avec les quotas horaires par matière"
              )
            }
          />
        </div>
      </div>
    </section>

    <%!-- CAMEROON --%>
    <section
      id="terrain"
      class="mx-auto grid max-w-6xl scroll-mt-20 gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:py-24"
    >
      <div>
        <p class="ta-eyebrow">{gettext("Pensé pour le Cameroun")}</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.01em] sm:text-4xl [text-wrap:balance]">
          {gettext("Pas un logiciel étranger traduit.")}
        </h2>
        <p class="ta-text-2 mt-4 text-[1.02rem] leading-relaxed [text-wrap:pretty]">
          {gettext(
            "Les niveaux, les séquences, les coefficients et les bulletins sont ceux de vos établissements. Chaque établissement règle les siens : rien n'est figé dans le logiciel."
          )}
        </p>
      </div>
      <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        <div :for={t <- terrain()} class="border-t border-base-300 pt-4">
          <dt class="font-semibold">{t.title}</dt>
          <dd class="ta-text-2 mt-1.5 leading-relaxed">{t.text}</dd>
        </div>
      </dl>
    </section>

    <%!-- GETTING STARTED + PRICE --%>
    <section id="tarif" class="scroll-mt-20 border-t border-base-300 bg-base-100">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-24">
        <div>
          <p class="ta-eyebrow">{gettext("Pour commencer")}</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-[-0.01em] sm:text-4xl">
            {gettext("Trois étapes, sans installation.")}
          </h2>
          <ol class="mt-8 flex flex-col gap-6">
            <li :for={{s, i} <- Enum.with_index(start_steps(), 1)} class="flex gap-4">
              <span class="ta-num grid size-9 flex-none place-items-center rounded-full bg-primary text-sm font-semibold text-primary-content">
                {i}
              </span>
              <div>
                <h3 class="font-semibold">{s.title}</h3>
                <p class="ta-text-2 mt-1 leading-relaxed">{s.text}</p>
              </div>
            </li>
          </ol>
        </div>

        <div class="ta-panel flex flex-col gap-4 self-start !p-6 sm:!p-8">
          <p class="ta-eyebrow">{gettext("Tarif")}</p>
          <h2 class="text-3xl font-semibold">{gettext("Gratuit pendant la phase pilote")}</h2>
          <p class="ta-text-2 leading-relaxed">
            {gettext(
              "Toutes les fonctionnalités et tous les rôles, pour tout l'établissement. Le tarif par élève et par an sera annoncé avant la rentrée."
            )}
          </p>
          <.link href={~p"/schools/start"} class="btn btn-primary btn-lg mt-2 min-h-12 self-start">
            {gettext("Inscrire mon établissement")}
            <.icon name="hero-arrow-right" class="size-5" />
          </.link>
        </div>
      </div>
    </section>

    <%!-- FAQ --%>
    <section id="questions" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="text-2xl font-semibold tracking-[-0.01em] sm:text-3xl">
        {gettext("Questions fréquentes")}
      </h2>
      <div class="mt-6 divide-y divide-base-300 border-y border-base-300">
        <details :for={{q, a} <- faq()} class="group">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold">
            {q}
            <.icon
              name="hero-chevron-down"
              class="size-5 flex-none transition-transform group-open:rotate-180"
            />
          </summary>
          <p class="ta-text-2 pb-5 leading-relaxed">{a}</p>
        </details>
      </div>
    </section>

    <%!-- CLOSING CTA --%>
    <section class="border-t border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <h2 class="text-2xl font-semibold tracking-[-0.01em] sm:text-3xl [text-wrap:balance]">
            {gettext("Votre établissement, prêt pour la prochaine séquence.")}
          </h2>
          <p class="ta-text-2 mt-2 leading-relaxed">
            {gettext("Le compte du chef d'établissement se crée en quelques minutes.")}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <.link href={~p"/schools/start"} class="btn btn-primary btn-lg min-h-12">
            {gettext("Inscrire mon établissement")}
          </.link>
          <.link href={~p"/sign-in"} class="btn btn-outline btn-lg min-h-12">
            {gettext("Se connecter")}
          </.link>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-base-300">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-8 text-sm sm:px-6">
      <span class="flex items-center gap-2">
        <span class="grid size-7 place-items-center rounded-md bg-primary text-xs font-bold text-primary-content ta-display">
          TA
        </span>
        <span class="font-semibold">Teacher Assistant</span>
      </span>
      <span class="ta-text-2">{gettext("Francophone et anglophone · Cameroun")}</span>
      <span class="flex flex-wrap items-center gap-x-1 sm:ml-auto">
        <.link href={~p"/sign-in"} class="ta-landing__nav">{gettext("Se connecter")}</.link>
        <.link href={~p"/schools/start"} class="ta-landing__nav">
          {gettext("Inscrire un établissement")}
        </.link>
        <.link href={~p"/locale/fr"} class="ta-landing__nav">FR</.link>
        <.link href={~p"/locale/en"} class="ta-landing__nav">EN</.link>
      </span>
    </div>
  </footer>
</div>
