<!DOCTYPE html>
<html lang={html_lang(@lang)}>
  <head>
    <meta charset="utf-8" />
    <TeacherAssistantWeb.PrintComponents.setup paper={:a4} />
    <title>{gettext("Cartes scolaires")} — {@cg.label}</title>
    <style>
      /* The sheet is drawn at its real size (A4, no printer margin) so the 2 × 5 grid and
         its crop marks sit where the cutter expects them. */
      @page { size: A4 portrait; margin: 0; }
      * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      body { margin: 0; font-family: "IBM Plex Sans", Arial, sans-serif; color: #14211B; background: #E4E8E5; }
      .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding: 12px 16px; background: #f4f1ea; }
      .sheet { position: relative; width: 210mm; height: 297mm; margin: 8mm auto; background: #fff; overflow: hidden;
               box-shadow: 0 2px 12px rgba(0,0,0,.18); }
      .caption { position: absolute; left: 19.3mm; top: 4mm; margin: 0; font-size: 7.5pt; color: #5B6A62; }
      .grid { position: absolute; left: 19.3mm; top: 13.3mm; display: grid; grid-template-columns: repeat(2, 85.6mm);
              grid-auto-rows: 54mm; }
      .mark { position: absolute; border: 0 solid #14211B; }
      .mark-v { border-left-width: 0.15mm; }
      .mark-h { border-top-width: 0.15mm; }

      /* One ID-1 card (85.6 × 54 mm): the flag down the left edge, then the content. */
      .card { position: relative; width: 85.6mm; height: 54mm; overflow: hidden; break-inside: avoid; display: flex;
              background: #fff; outline: 0.15mm solid #D5DBD7; outline-offset: -0.075mm; line-height: 1.15; }
      .flag { width: 1.5mm; flex: none; background: linear-gradient(180deg, #007A5E 33.33%, #CE1126 33.33% 66.66%, #FCD116 66.66%); }
      .inner { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1.2mm; padding: 2mm 2.3mm 1.7mm 2mm; }

      .hd { display: flex; align-items: center; gap: 1.7mm; }
      .logo { flex: none; width: 7.7mm; height: 7.7mm; border-radius: 50%; object-fit: contain; }
      .hd-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.25mm; }
      .rep { font-size: 5pt; font-weight: 600; letter-spacing: 0.06em; color: #4A5A52; text-transform: uppercase;
             white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .school { font-size: 7pt; font-weight: 700; line-height: 1.1; color: #1F3A2E; display: -webkit-box;
                -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .code { font-size: 5pt; color: #4A5A52; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .year { flex: none; align-self: flex-start; padding: 0.6mm 1.3mm; border-radius: 0.8mm; background: #FCD116;
              font: 600 5.6pt "IBM Plex Mono", ui-monospace, monospace; }

      .band { display: flex; justify-content: space-between; align-items: center; padding: 0.5mm 1.3mm; border-radius: 0.7mm;
              background: #1F3A2E; color: #fff; font-size: 5pt; font-weight: 700; letter-spacing: 0.1em; }
      .band span + span { font-weight: 500; opacity: 0.85; }

      .body { flex: 1; min-height: 0; display: flex; gap: 1.8mm; }
      .pic { flex: none; position: relative; width: 20mm; height: 25mm; }
      .photo { display: block; width: 20mm; height: 25mm; object-fit: cover; border: 0.2mm solid #1F3A2E; }
      .photo-empty { width: 20mm; height: 25mm; border: 0.2mm solid #1F3A2E; background: #EEF1EE; display: grid;
                     place-items: center; font-size: 5pt; color: #5B6A62; }
      .stamp { position: absolute; right: -3.7mm; bottom: -2.3mm; width: 10mm; height: 10mm; object-fit: contain;
               transform: rotate(-12deg); mix-blend-mode: multiply; opacity: 0.9; }

      .mid { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1mm; }
      .name { margin: 0; font-size: 7.5pt; font-weight: 700; line-height: 1.1; display: -webkit-box; -webkit-line-clamp: 2;
              -webkit-box-orient: vertical; overflow: hidden; }
      .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8mm 1.2mm; }
      .f { min-width: 0; }
      .f.wide { grid-column: span 2; }
      .f .l { font-size: 5pt; font-weight: 600; letter-spacing: 0.03em; color: #5B6A62; text-transform: uppercase;
              white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .lang-bilingual .f .l { text-transform: none; letter-spacing: 0; }
      .f .v { font-size: 6.2pt; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .f .v.strong { font-weight: 700; }
      .f .v.mono { font-family: "IBM Plex Mono", ui-monospace, monospace; font-weight: 500; }

      .sign { margin-top: auto; }
      .sign-line { height: 3mm; border-bottom: 0.2mm solid #8A968F; display: flex; align-items: flex-end; }
      .sign-line img { max-height: 3.4mm; max-width: 18mm; object-fit: contain; }
      .sign p { margin: 0.4mm 0 0; font-size: 5pt; color: #4A5A52; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .sign p + p { margin-top: 0; font-weight: 600; color: #14211B; }

      .qr { flex: none; width: 13mm; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 0.5mm; }
      .qr svg { display: block; width: 13mm; height: 13mm; }
      .qr span { font-size: 5pt; line-height: 1.15; color: #4A5A52; text-align: center; }

      @media print {
        body { background: #fff; }
        .toolbar { display: none; }
        .sheet { margin: 0; box-shadow: none; break-after: page; }
        .sheet:last-of-type { break-after: auto; }
      }
    </style>
  </head>
  <body class={"lang-#{@lang}"}>
    <div class="toolbar print-actions">
      <button type="button" data-print>{gettext("Imprimer")}</button>
      <span>{gettext("Imprimer en A4, échelle 100 %, sans marges.")}</span>
      <span :if={@missing > 0}>
        {ngettext("1 élève sans photo", "%{count} élèves sans photo", @missing)} —
        <a href={~p"/school/classes/#{@cg.id}/photos"}>{gettext("Compléter les photos")}</a>
      </span>
    </div>

    <main
      :for={{cards, i} <- Enum.with_index(@pages, 1)}
      class="sheet"
      aria-label={sheet_caption(@cg.label, i, length(@pages), length(cards))}
    >
      <p class="caption">{sheet_caption(@cg.label, i, length(@pages), length(cards))}</p>

      <div class="grid">
        <article :for={c <- cards} class="card">
          <div class="flag"></div>
          <div class="inner">
            <header class="hd">
              <img :if={@logo?} class="logo" src={~p"/school/logo"} alt="" />
              <div class="hd-text">
                <span class="rep">{republic_line(@header)}</span>
                <span class="school">{@school}</span>
                <span :if={contact_line(@header) != ""} class="code">{contact_line(@header)}</span>
              </div>
              <span :if={@year} class="year">{@year}</span>
            </header>

            <div class="band"><span>CARTE SCOLAIRE</span><span>STUDENT ID CARD</span></div>

            <div class="body">
              <div class="pic">
                <img
                  :if={c.student.photo_path}
                  class="photo"
                  src={student_photo_url(c.student)}
                  alt=""
                />
                <div :if={!c.student.photo_path} class="photo-empty">
                  {card_label(@lang, fn -> gettext("Photo") end)}
                </div>
                <img :if={@stamp?} class="stamp" src={~p"/school/logo?kind=stamp"} alt="" />
              </div>

              <div class="mid">
                <p class="name">{c.student.full_name}</p>
                <div class="fields">
                  <div class="f">
                    <div class="l">{card_label(@lang, fn -> gettext("Classe") end)}</div>
                    <div class="v strong">{@cg.label}</div>
                  </div>
                  <div class="f">
                    <div class="l">{card_label(@lang, fn -> gettext("Sexe") end)}</div>
                    <div class="v">{sex_label(c.student.sex)}</div>
                  </div>
                  <div class="f">
                    <div class="l">{card_label(@lang, fn -> gettext("Né(e) le") end)}</div>
                    <div class="v">{date(c.student.birth_date) || "—"}</div>
                  </div>
                  <div class="f">
                    <div class="l">{card_label(@lang, fn -> gettext("à") end)}</div>
                    <div class="v">{c.student.birth_place || "—"}</div>
                  </div>
                  <div class="f">
                    <div class="l">{card_label(@lang, fn -> gettext("Matricule") end)}</div>
                    <div class="v mono">{c.student.matricule || "—"}</div>
                  </div>
                  <div class="f">
                    <div class="l">{card_label(@lang, fn -> gettext("Urgence") end)}</div>
                    <div class="v mono">{(c.contact && c.contact.phone) || "—"}</div>
                  </div>
                  <div :if={c.student.national_id} class="f wide">
                    <div class="l">
                      {card_label(@lang, fn -> gettext("Identifiant unique") end)}
                    </div>
                    <div class="v mono">{c.student.national_id}</div>
                  </div>
                </div>

                <div class="sign">
                  <div class="sign-line">
                    <img :if={@signature?} src={~p"/school/logo?kind=signature"} alt="" />
                  </div>
                  <p>{head_title(@header)}</p>
                  <p :if={@header.head_name}>{@header.head_name}</p>
                </div>
              </div>

              <div class="qr">
                <div :if={c.qr_svg}>{Phoenix.HTML.raw(c.qr_svg)}</div>
                <span :for={line <- card_lines(@lang, fn -> gettext("Scanner pour vérifier") end)}>
                  {line}
                </span>
              </div>
            </div>
          </div>
        </article>
      </div>

      <span :for={{class, style} <- crop_marks()} class={class} style={style}></span>
    </main>
  </body>
</html>
