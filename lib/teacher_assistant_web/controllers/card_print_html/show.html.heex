<!DOCTYPE html>
<html lang={html_lang(@lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{gettext("Cartes scolaires")} — {@cg.label}</title>
    <style>
      @page { size: A4 portrait; margin: 10mm 14mm; }
      * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      body { margin: 0; font-family: "IBM Plex Sans", Arial, sans-serif; color: #111; }
      .toolbar { display: flex; gap: 12px; align-items: center; padding: 12px 16px; background: #f4f1ea; }
      .sheet { display: grid; grid-template-columns: repeat(2, 85.6mm); grid-auto-rows: 54mm; gap: 0; justify-content: center; padding: 6mm 0; }
      .sheet + .sheet { break-before: page; }
      .card { position: relative; width: 85.6mm; height: 54mm; outline: 0.2mm dashed #999; overflow: hidden; break-inside: avoid;
              display: flex; flex-direction: column; font-size: 5.4pt; line-height: 1.2; }
      .flag { height: 1mm; flex: none; background: linear-gradient(90deg, #007a5e 33.3%, #ce1126 33.3% 66.6%, #fcd116 66.6%); }
      .nat { display: grid; grid-template-columns: 1fr 9mm 1fr; gap: 1mm; text-align: center; font-size: 3.9pt; padding: 0.8mm 1.5mm 0; color: #333; }
      .nat .col div:first-child { font-weight: 700; font-size: 4.3pt; color: #111; text-transform: uppercase; }
      .nat .col div:nth-child(2) { font-style: italic; }
      .nat .col div:nth-child(3) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .nat img { height: 8mm; width: 8mm; object-fit: contain; margin: 0 auto; }
      .sch { text-align: center; padding: 0.4mm 1.5mm 0; }
      .sch .n { font-weight: 700; font-size: 6.2pt; color: #1f3a2e; text-transform: uppercase; }
      .sch .c { font-size: 4.4pt; color: #444; }
      .ttl { margin: 0.7mm 2mm 0; background: #1f3a2e; color: #fff; text-align: center; font-weight: 700; font-size: 5.2pt;
             letter-spacing: .05em; padding: 0.5mm; border-radius: 0.8mm; }
      .body { display: grid; grid-template-columns: 18mm 1fr 14mm; gap: 1.8mm; padding: 1.2mm 2mm 0; }
      .photo { width: 18mm; height: 22mm; object-fit: cover; border: 0.2mm solid #333; }
      .photo-empty { width: 18mm; height: 22mm; border: 0.2mm dashed #666; display: grid; place-items: center; font-size: 5pt; color: #666; }
      .name { font-weight: 700; font-size: 7pt; line-height: 1.1; margin-bottom: 0.6mm; }
      .fields div { line-height: 1.35; }
      .fields b { font-weight: 400; color: #555; }
      .side { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 1mm; }
      .year { background: #fcd116; color: #111; font-weight: 700; padding: 0.4mm 1mm; border-radius: 0.8mm; }
      .qr svg { width: 12mm; height: 12mm; }
      .foot { position: absolute; left: 2mm; right: 2mm; bottom: 1.2mm; display: flex; justify-content: flex-end; font-size: 4.6pt; }
      .head { text-align: right; position: relative; }
      .head .marks { display: flex; gap: 1mm; justify-content: flex-end; align-items: flex-end; }
      .head .marks img { height: 6mm; }
      @media print { .toolbar { display: none; } .sheet { padding: 0; } }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <button type="button" onclick="window.print()">{gettext("Imprimer")}</button>
      <span :if={@missing > 0}>
        {ngettext("1 élève sans photo", "%{count} élèves sans photo", @missing)} —
        <a href={~p"/school/classes/#{@cg.id}/photos"}>{gettext("Compléter les photos")}</a>
      </span>
    </div>

    <main :for={cards <- @pages} class="sheet">
      <article :for={c <- cards} class="card">
        <div class="flag"></div>
        <div class="nat">
          <div class="col">
            <div :for={line <- card_lines(@header, :fr)}>{line}</div>
          </div>
          <img :if={@logo?} src={~p"/school/logo"} alt="" />
          <div :if={!@logo?}></div>
          <div class="col">
            <div :for={line <- card_lines(@header, :en)}>{line}</div>
          </div>
        </div>
        <div class="sch">
          <div class="n">{@school}</div>
          <div class="c">{contact_line(@header)}</div>
        </div>
        <div class="ttl">CARTE SCOLAIRE · SCHOOL IDENTITY CARD</div>
        <div class="body">
          <img :if={c.student.photo_path} class="photo" src={student_photo_url(c.student)} alt="" />
          <div :if={!c.student.photo_path} class="photo-empty">
            {tr(@lang, fn -> gettext("Photo") end)}
          </div>
          <div>
            <div class="name">{c.student.full_name}</div>
            <div class="fields">
              <div :if={c.student.birth_date || c.student.birth_place}>
                <b>{tr(@lang, fn -> gettext("Né(e) le") end)}</b>
                {date(c.student.birth_date)}
                <span :if={c.student.birth_place}>
                  <b>{tr(@lang, fn -> gettext("à") end)}</b> {c.student.birth_place}
                </span>
              </div>
              <div>
                <b>{tr(@lang, fn -> gettext("Classe") end)}</b> <strong>{@cg.label}</strong>
                · <b>{tr(@lang, fn -> gettext("Sexe") end)}</b> {sex_label(c.student.sex)}
              </div>
              <div :if={c.student.matricule}>
                <b>{tr(@lang, fn -> gettext("Matricule") end)}</b> {c.student.matricule}
              </div>
              <div :if={c.student.national_id}>
                <b>{tr(@lang, fn -> gettext("Identifiant unique") end)}</b> {c.student.national_id}
              </div>
              <div :if={c.contact}>
                <b>{tr(@lang, fn -> gettext("Contact") end)}</b> {c.contact.full_name} · {c.contact.phone}
              </div>
            </div>
          </div>
          <div class="side">
            <div :if={@year} class="year">{@year}</div>
            <div :if={c.qr_svg} class="qr">{Phoenix.HTML.raw(c.qr_svg)}</div>
          </div>
        </div>
        <div class="foot">
          <div class="head">
            <div class="marks">
              <img :if={@stamp?} src={~p"/school/logo?kind=stamp"} alt="" />
              <img :if={@signature?} src={~p"/school/logo?kind=signature"} alt="" />
            </div>
            <div>{head_title(@header)}</div>
            <div :if={@header.head_name}>{@header.head_name}</div>
          </div>
        </div>
      </article>
    </main>
  </body>
</html>
