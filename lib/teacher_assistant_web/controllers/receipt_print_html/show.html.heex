<!DOCTYPE html>
<html lang={Gettext.get_locale(TeacherAssistantWeb.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{gettext("Reçu n° %{number}", number: @receipt.payment.number)}</title>
    <style>
      @page { size: A5; margin: 10mm; }
      body { font-family: Georgia, "Times New Roman", serif; color: #111; margin: 0; padding: 16px; font-size: 10.5pt; line-height: 1.35; }
      .sheet { max-width: 560px; margin: 0 auto; position: relative; }
      .national { text-align: center; font-size: 8.5pt; }
      .national .fr { font-variant: small-caps; font-weight: bold; }
      .national .en { color: #444; }
      .school { text-align: center; font-weight: bold; font-size: 12pt; margin: 6px 0 2px; }
      h1 { text-align: center; font-size: 14pt; margin: 8px 0; letter-spacing: .02em; }
      dl { display: grid; grid-template-columns: 34% 1fr; gap: 3px 10px; margin: 8px 0; }
      dt { font-variant: small-caps; color: #444; }
      .amount { font-size: 13pt; font-weight: bold; }
      .words { font-style: italic; }
      table { width: 100%; border-collapse: collapse; margin: 8px 0; }
      th, td { border: 1px solid #999; padding: 3px 6px; } th { background: #f0f0f0; font-variant: small-caps; font-weight: normal; }
      td.n, th.n { text-align: right; white-space: nowrap; }
      .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; margin-top: 10px; }
      .check { font-size: 8pt; color: #333; }
      .check .code { font-family: ui-monospace, monospace; font-size: 11pt; font-weight: bold; letter-spacing: .08em; }
      .cancelled { position: absolute; inset: 35% 0 auto; text-align: center; font-size: 34pt; font-weight: bold; color: rgba(160, 30, 20, .35); transform: rotate(-18deg); pointer-events: none; }
      .actions { max-width: 560px; margin: 16px auto 0; display: flex; flex-wrap: wrap; gap: 8px; font-family: system-ui, sans-serif; }
      .actions a, .actions button { font: inherit; font-size: 10pt; padding: 8px 12px; border-radius: 8px; border: 1px solid #11663a; background: #fff; color: #11663a; text-decoration: none; cursor: pointer; }
      .actions .primary { background: #11663a; color: #fff; }
      @media print { .actions { display: none; } body { padding: 0; } }
    </style>
  </head>
  <body>
    <% p = @receipt.payment %>
    <div class="sheet">
      <div :if={p.status == :cancelled} class="cancelled">{gettext("Reçu annulé")}</div>
      <div class="national">
        <div class="fr">République du Cameroun — Paix – Travail – Patrie</div>
        <div class="en">Republic of Cameroon — Peace – Work – Fatherland</div>
      </div>
      <div class="school">{@receipt.school.name}</div>
      <h1>{gettext("Reçu n° %{number}", number: p.number)}</h1>

      <dl>
        <dt>{gettext("Élève")}</dt><dd>{@receipt.student_name}</dd>
        <dt :if={@receipt.student.matricule}>{gettext("Matricule")}</dt>
        <dd :if={@receipt.student.matricule}>{@receipt.student.matricule}</dd>
        <dt>{gettext("Classe")}</dt><dd>{@receipt.class_label}</dd>
        <dt>{gettext("Date")}</dt><dd>{date(p.paid_on)}</dd>
        <dt>{gettext("Mode")}</dt>
        <dd>{PaymentMethod.label(p.method)}<span :if={p.reference}> · {p.reference}</span></dd>
        <dt>{gettext("Montant")}</dt>
        <dd>
          <span class="amount">{Money.format_fcfa(p.amount)}</span><br />
          <span class="words">{in_words(p.amount)}</span>
        </dd>
      </dl>

      <table>
        <tr>
          <th>{gettext("Frais")}</th>
          <th class="n">{gettext("Ce reçu")}</th>
        </tr>
        <tr :for={a <- @receipt.allocations}>
          <td>{a.name}</td>
          <td class="n">{Money.format_fcfa(a.amount)}</td>
        </tr>
        <tr>
          <th>{gettext("Total")}</th>
          <th class="n">{Money.format_fcfa(p.amount)}</th>
        </tr>
      </table>

      <dl>
        <dt>{gettext("Total payé à ce jour")}</dt><dd>{Money.format_fcfa(p.paid_to_date)}</dd>
        <dt>{gettext("Reste à payer")}</dt><dd><b>{left(p.left_after)}</b></dd>
      </dl>

      <div class="foot">
        <div>
          <div :if={@receipt.recorded_by_name}>
            {gettext("Reçu par : %{name}", name: @receipt.recorded_by_name)}
          </div>
          <div class="check">
            {gettext(
              "Vérifiez ce reçu en scannant le code QR, ou sur %{url} avec le numéro et le code :",
              url: @lookup_url
            )}
            <div class="code">{@code}</div>
          </div>
        </div>
        <div>{Phoenix.HTML.raw(@qr)}</div>
      </div>
    </div>

    <div :if={p.status == :valid} class="actions">
      <button type="button" class="primary" onclick="window.print()">
        {gettext("Imprimer le reçu")}
      </button>
      <a
        :for={g <- @receipt.guardians}
        :if={url = whatsapp_url(g.phone, whatsapp_message(@receipt, @check_url))}
        href={url}
        target="_blank"
        rel="noopener"
      >
        {gettext("Envoyer par WhatsApp à %{name}", name: g.name)}
      </a>
    </div>
  </body>
</html>
