<!DOCTYPE html>
<html lang={html_lang(hd(@sheets).lang)}>
  <head>
    <meta charset="utf-8" />
    <TeacherAssistantWeb.PrintComponents.setup paper={:a4} />
    <title>{@title}</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: "IBM Plex Sans", Arial, Helvetica, sans-serif;
        color: #111; background: #fff; margin: 0; padding: 16px;
        font-size: 9pt; line-height: 1.25;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      @page { size: A4; margin: 10mm; }
      @media print { body { padding: 0; } tr { break-inside: avoid; } }
      .header { display: grid; grid-template-columns: 1fr 36mm 1fr; gap: 2mm; text-align: center; font-size: 0.86em; }
      .header .col div:first-child { font-weight: bold; text-transform: uppercase; }
      .header .col div:nth-child(2) { font-style: italic; }
      .header .col div:nth-child(n+3) { text-transform: uppercase; }
      .header .mid img { max-height: 18mm; max-width: 30mm; }
      .header .code { font-weight: 700; margin-top: 1mm; letter-spacing: .02em; }
      .school { display: grid; grid-template-columns: 1fr 36mm 1fr; gap: 2mm; text-align: center; margin-top: 1mm; font-size: 0.9em; }
      .school .name { font-size: 1.2em; font-weight: bold; text-transform: uppercase; }
      .flag { height: 0.9mm; margin: 1.2mm 0 0;
              background: linear-gradient(90deg, #007a5e 33.3%, #ce1126 33.3% 66.6%, #fcd116 66.6%); }
      h1 { text-align: center; font-size: 1.45em; letter-spacing: .06em; margin: 3mm 0 1mm; }
      .meta { text-align: center; margin-bottom: 3mm; }
      table { border-collapse: collapse; width: 100%; }
      thead { display: table-header-group; }
      th, td { border: 0.2mm solid #555; padding: 0.8mm 1.4mm; text-align: left; }
      th { background: #eee; font-size: 0.9em; }
      .c { text-align: center; }
      .num { width: 9mm; }
      .mat { width: 28mm; }
      .sex { width: 12mm; }
      .birth { width: 58mm; }
      .rep { width: 11mm; }
      .foot { display: flex; justify-content: space-between; gap: 6mm; margin-top: 4mm; }
      .head { text-align: center; min-width: 50mm; }
      .head .space { height: 18mm; }
      /* the whole school: one class per page */
      .sheet + .sheet { break-before: page; margin-top: 8mm; }
    </style>
  </head>
  <body>
    <TeacherAssistantWeb.PrintComponents.print_bar />

    <section :for={sheet <- @sheets} class="sheet">
      <.official_header header={sheet.template.header} logo?={sheet.template.header.logo?} />

      <h1>{tr(sheet.lang, fn -> gettext("LISTE DE CLASSE") end)}</h1>
      <p class="meta">
        {sheet.cg.label}
        <span :if={sheet.year}>— {tr(sheet.lang, fn -> gettext("Année scolaire") end)} {sheet.year}</span>
        <span :if={sheet.form_master}>
          — {tr(sheet.lang, fn -> gettext("Professeur principal") end)} : {sheet.form_master}
        </span>
      </p>

      <% totals = totals(sheet.rows) %>
      <table>
        <thead>
          <tr>
            <th class="c num">{tr(sheet.lang, fn -> gettext("N°") end)}</th>
            <th class="mat">{tr(sheet.lang, fn -> gettext("Matricule") end)}</th>
            <th>{tr(sheet.lang, fn -> gettext("Noms et prénoms") end)}</th>
            <th class="c sex">{tr(sheet.lang, fn -> gettext("Sexe") end)}</th>
            <th class="birth">
              {tr(sheet.lang, fn -> gettext("Date et lieu de naissance") end)}
            </th>
            <th class="c rep">{tr(sheet.lang, fn -> gettext("Red.") end)}</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={{row, n} <- sheet.rows}>
            <td class="c">{n}</td>
            <td>{row.student.matricule}</td>
            <td>{row.student.full_name}</td>
            <td class="c">{sex_letter(row.student.sex)}</td>
            <td>{birth(sheet.lang, row.student)}</td>
            <td class="c">{if row.enrollment.repeater, do: "R"}</td>
          </tr>
        </tbody>
      </table>

      <div class="foot">
        <div class="totals">
          {tr(sheet.lang, fn -> gettext("Effectif") end)} : {totals.total} — {tr(sheet.lang, fn ->
            gettext("Garçons")
          end)} : {totals.boys} — {tr(sheet.lang, fn -> gettext("Filles") end)} : {totals.girls} — {tr(
            sheet.lang,
            fn -> gettext("Redoublants") end
          )} : {totals.repeaters}
        </div>
        <div class="head">
          <div>{head_title(sheet.lang, sheet.template.header)}</div>
          <div class="space"></div>
          <div :if={sheet.head_name}>{sheet.head_name}</div>
        </div>
      </div>
    </section>
  </body>
</html>
