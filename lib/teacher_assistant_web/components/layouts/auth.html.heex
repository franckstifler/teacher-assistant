<%!--
  Auth pages — paper palette (the public, pre-login world), matching the
  "Onboarding.dc.html" design proposal's isAuth screens: a dark brand panel
  beside a white boxed-input form. Scoped to `.ta-auth-paper` so the rest of
  the app keeps the Tableau chalkboard identity — the same scoping pattern
  the landing page uses for `.ta-landing` (see page_html/home.html.heex).

  Wraps every AshAuthentication.Phoenix page: sign-in, register, the "forgot
  password" request step, the request confirmation and password fields are
  supplied by AshAuthentication.Phoenix itself (styled via AuthOverrides);
  this layout only supplies the surrounding chrome and the per-screen
  eyebrow/title/subtitle/reassurance copy (see Layouts.auth_copy/1).
--%>
<% assigns = assign(assigns, :auth_copy, auth_copy(assigns)) %>
<% assigns = assign(assigns, :auth_points, auth_points()) %>
<style>
  .ta-auth-paper {
    background: #F4F1EA;
    color: #1E2A2B;
    font-family: "Libre Franklin", ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .ta-auth-paper h1, .ta-auth-paper h2 { font-family: Fraunces, Georgia, "Times New Roman", serif; }
  .ta-auth-paper a { color: #0E7A5F; text-decoration: none; }
  .ta-auth-paper a:hover { color: #0B5E49; text-decoration: underline; }
  .ta-auth-paper .ta-mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }

  /* boxed fields — a rule you fill in, not a chalk-underline */
  .ta-auth-paper input[type="email"],
  .ta-auth-paper input[type="text"],
  .ta-auth-paper input[type="password"] {
    display: block;
    width: 100%;
    height: 2.5rem;
    padding: 0 0.7rem;
    border: 1px solid #D7CFBE;
    border-radius: 0.45rem;
    background: #FFFFFF;
    font-family: inherit;
    font-size: 0.88rem;
    color: #1E2A2B;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .ta-auth-paper input::placeholder { color: #8A9391; }
  .ta-auth-paper input[type="email"]:focus,
  .ta-auth-paper input[type="text"]:focus,
  .ta-auth-paper input[type="password"]:focus {
    border-color: #0E7A5F;
    box-shadow: 0 0 0 3px rgba(14, 122, 95, 0.14);
  }
  .ta-auth-paper .ta-field-input-error { border-color: #B3452E !important; }
  /* keep the boxed-white look when the browser autofills a field (and when
     Chrome/Safari paint a "recognized login form" suggestion highlight on an
     unfilled field with saved credentials for this origin) */
  .ta-auth-paper input:-webkit-autofill,
  .ta-auth-paper input:-webkit-autofill:hover,
  .ta-auth-paper input:-webkit-autofill:focus {
    -webkit-text-fill-color: #1E2A2B;
    -webkit-box-shadow: 0 0 0 1000px #FFFFFF inset;
    box-shadow: 0 0 0 1000px #FFFFFF inset;
    caret-color: #1E2A2B;
    border-radius: 0.45rem;
  }
  .ta-auth-paper input[type="checkbox"] {
    width: 0.95rem;
    height: 0.95rem;
    accent-color: #0E7A5F;
  }

  .ta-auth-paper .ta-field-wrap { margin: 0 0 0.9rem; }
  .ta-auth-paper .ta-field-label,
  .ta-auth-paper .fieldset .label {
    display: block;
    margin: 0 0 0.3rem;
    font-size: 0.78rem;
    font-weight: 650;
    color: #44514F;
  }
  .ta-auth-paper .ta-error-list {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    color: #B3452E;
  }

  .ta-auth-paper .ta-remember-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: -0.2rem 0 0.9rem;
    font-size: 0.82rem;
    color: #44514F;
    cursor: pointer;
  }
  .ta-auth-paper .ta-toggler-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin: 0 0 0.9rem;
  }
  .ta-auth-paper .ta-toggler-row a { font-size: 0.8rem; font-weight: 650; }

  .ta-auth-paper button[type="submit"] {
    display: block;
    width: 100%;
    height: 2.7rem;
    margin-top: 0.2rem;
    border: 0;
    border-radius: 0.5rem;
    background: #0E7A5F;
    color: #FFFFFF;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .ta-auth-paper button[type="submit"]:hover { background: #0B5E49; }
  .ta-auth-paper button[type="submit"]:active { transform: translateY(1px); }
  .ta-auth-paper button[type="submit"]:disabled { opacity: 0.7; cursor: default; }

  .ta-auth-paper .ta-auth-error {
    margin: 0 0 0.9rem;
    border: 1px solid #E7B9AC;
    border-radius: 0.5rem;
    background: #FBEAE4;
    color: #7A2E1C;
    padding: 0.6rem 0.8rem;
    font-size: 0.82rem;
  }

  /* column heading for pages that render their own (Account.PasswordLive) */
  .ta-auth-paper .ta-auth-eyebrow {
    margin: 0;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0E7A5F;
  }
  .ta-auth-paper .ta-auth-title {
    margin: 0.4rem 0 0;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1E2A2B;
  }
  .ta-auth-paper .ta-auth-sub {
    margin: 0.5rem 0 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: #5A6668;
  }

  /* who is signed in: initials, name, « phone · school » */
  .ta-auth-paper .ta-identity-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid #EFEAE0;
    border-radius: 0.75rem;
    background: #FAF8F3;
  }
  .ta-auth-paper .ta-identity-card__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: #172321;
    color: #E8E5DC;
    font-family: Fraunces, Georgia, serif;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ta-auth-paper .ta-identity-card__name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1E2A2B;
  }
  .ta-auth-paper .ta-identity-card__line {
    margin: 0;
    font-size: 0.75rem;
    color: #5A6668;
  }

  /* live password checklist — the round mark turns green when met */
  .ta-auth-paper .ta-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #44514F;
  }
  .ta-auth-paper .ta-check__mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid #D7CFBE;
    border-radius: 9999px;
    background: #FFFFFF;
    color: transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .ta-auth-paper .ta-check[data-met] .ta-check__mark {
    border-color: #0E7A5F;
    background: #0E7A5F;
    color: #FFFFFF;
  }

  /* /sign-in (Auth.SignInLive): « Téléphone | Adresse e-mail » switch — both
     forms stay in the DOM, `data-method` on the wrapper picks the visible one */
  .ta-auth-paper .ta-segmented {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    margin: 0 0 1.1rem;
    padding: 0.25rem;
    border: 1px solid #EFEAE0;
    border-radius: 0.6rem;
    background: #FAF8F3;
  }
  .ta-auth-paper .ta-segmented__option {
    height: 2.1rem;
    border: 0;
    border-radius: 0.45rem;
    background: transparent;
    color: #5A6668;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }
  .ta-auth-paper .ta-segmented__option:hover { color: #1E2A2B; }
  .ta-auth-paper .ta-segmented__option[aria-pressed="true"] {
    background: #FFFFFF;
    color: #0E7A5F;
    box-shadow: 0 1px 2px rgba(23, 35, 33, 0.12);
  }
  .ta-auth-paper .ta-sign-in-methods[data-method="phone"] .ta-email-form,
  .ta-auth-paper .ta-sign-in-methods[data-method="email"] .ta-phone-form { display: none; }

  /* +237 chip glued to the left of the phone input */
  .ta-auth-paper .ta-phone-form .ta-field-wrap:has(input[name$="[phone]"]) {
    display: grid;
    grid-template-columns: auto 1fr;
  }
  .ta-auth-paper .ta-phone-form .ta-field-wrap:has(input[name$="[phone]"]) > :not(input) { grid-column: 1 / -1; }
  .ta-auth-paper .ta-phone-form .ta-field-wrap:has(input[name$="[phone]"])::before {
    content: "+237";
    grid-row: 2;
    grid-column: 1;
    display: flex;
    align-items: center;
    padding: 0 0.65rem;
    border: 1px solid #D7CFBE;
    border-right: 0;
    border-radius: 0.45rem 0 0 0.45rem;
    background: #FAF8F3;
    color: #44514F;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.85rem;
  }
  .ta-auth-paper .ta-phone-form input[name$="[phone]"] {
    grid-row: 2;
    grid-column: 2;
    border-radius: 0 0.45rem 0.45rem 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing: 0.02em;
  }

  /* sign-in failure (flash from AuthController, or a refused submission) */
  .ta-auth-paper .ta-auth-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0 0 1rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid #E7B9AC;
    border-radius: 0.55rem;
    background: #FBEAE4;
    color: #7A2E1C;
  }
  .ta-auth-paper .ta-auth-alert--warning {
    border-color: #E8CF9A;
    background: #FBF3E1;
    color: #6E4E12;
  }
  .ta-auth-paper .ta-auth-alert__icon { flex: none; margin-top: 0.1rem; }
  .ta-auth-paper .ta-auth-alert__title { margin: 0; font-size: 0.84rem; font-weight: 700; }
  .ta-auth-paper .ta-auth-alert__text { margin: 0.2rem 0 0; font-size: 0.8rem; line-height: 1.5; }

  /* « Mot de passe oublié ? » for phone accounts, phone note on /reset */
  .ta-auth-paper .ta-auth-info {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding: 0.7rem 0.8rem;
    border: 1px solid #EFEAE0;
    border-radius: 0.55rem;
    background: #FAF8F3;
    color: #44514F;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .ta-auth-paper .ta-auth-info p { margin: 0; }
  .ta-auth-paper .ta-auth-info strong { color: #1E2A2B; }
  .ta-auth-paper .ta-auth-info__icon { flex: none; margin-top: 0.12rem; color: #0E7A5F; }

  .ta-auth-paper .ta-auth-footnote {
    margin: 1.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid #EFEAE0;
    font-size: 0.82rem;
    color: #5A6668;
    text-align: center;
  }
  .ta-auth-paper .ta-auth-footnote a { font-weight: 650; }

  .ta-auth-paper :where(a, button, input, [role="button"]):focus-visible {
    outline: 2px solid #0E7A5F;
    outline-offset: 2px;
    border-radius: 0.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ta-auth-paper * { transition: none !important; }
  }
</style>

<div class="ta-auth-paper flex min-h-screen flex-col lg:flex-row">
  <%!-- brand panel — stacked on top at phone widths, side-by-side from lg --%>
  <aside
    class="flex flex-col justify-between gap-8 px-6 py-8 sm:px-10 sm:py-10 lg:w-[42%] lg:px-14 lg:py-12"
    style="background: #172321; color: #E8E5DC"
  >
    <a href="/" class="flex items-center gap-2.5">
      <span
        class="grid size-9 place-items-center rounded-lg"
        style="background: #E8E5DC; color: #172321; font-family: Fraunces, Georgia, serif; font-size: 1rem; font-weight: 700"
      >
        TA
      </span>
      <span style="font-family: Fraunces, Georgia, serif; font-size: 1.05rem; font-weight: 600; color: #FFFFFF">
        Teacher Assistant
      </span>
    </a>

    <div :if={@auth_copy[:panel]} class="max-w-md">
      <p
        class="ta-mono"
        style="margin: 0; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #8FC9B4"
      >
        {@auth_copy.panel.eyebrow}
      </p>
      <h2 style="margin: 0.8rem 0 0; font-size: 1.85rem; font-weight: 650; line-height: 1.15; color: #FFFFFF">
        {@auth_copy.panel.title}
      </h2>
      <p style="margin: 1.2rem 0 0; font-size: 0.92rem; line-height: 1.6; color: #C9D3CF">
        {@auth_copy.panel.text}
      </p>
    </div>
    <div :if={!@auth_copy[:panel]} class="max-w-md">
      <p
        class="ta-mono"
        style="margin: 0; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #8FC9B4"
      >
        Établissements secondaires · Cameroun
      </p>
      <h2 style="margin: 0.8rem 0 0; font-size: 1.85rem; font-weight: 650; line-height: 1.15; color: #FFFFFF">
        Tout l'établissement sur un seul tableau.
      </h2>
      <div class="mt-6 flex flex-col gap-3">
        <span
          :for={point <- @auth_points}
          class="flex items-center gap-3"
          style="font-size: 0.88rem; color: #C9D3CF"
        >
          <span
            class="grid size-6 flex-none place-items-center rounded-full"
            style="background: #24332F; color: #8FC9B4"
          >
            <.icon name="hero-check" class="size-3.5" />
          </span>
          {point}
        </span>
      </div>
    </div>

    <p class="ta-mono" style="margin: 0; font-size: 0.72rem; color: #778A84">
      APC / CBA · Francophone &amp; anglophone · FR / EN
    </p>
  </aside>

  <%!-- form column --%>
  <main
    class="flex flex-1 items-center justify-center px-4 py-10 sm:px-6 lg:px-10"
    style="background: #FFFFFF"
  >
    <div class="w-full max-w-sm">
      <%= if @auth_copy.title do %>
        <p
          class="ta-mono"
          style="margin: 0; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #0E7A5F"
        >
          {@auth_copy.eyebrow}
        </p>
        <h1 style="margin: 0.4rem 0 0; font-size: 1.55rem; font-weight: 700; letter-spacing: -0.01em; color: #1E2A2B">
          {@auth_copy.title}
        </h1>
        <p
          :if={@auth_copy.sub}
          style="margin: 0.5rem 0 0; font-size: 0.86rem; line-height: 1.55; color: #5A6668"
        >
          {@auth_copy.sub}
        </p>
      <% end %>

      <div class={@auth_copy.title && "mt-5"}>
        {@inner_content}
      </div>

      <div
        :if={@auth_copy.foot}
        class="mt-6 flex items-start gap-2 border-t pt-4"
        style="border-color: #EFEAE0"
      >
        <span style="color: #5A6668; flex: none; margin-top: 0.1rem">
          <.icon name="hero-shield-check" class="size-4" />
        </span>
        <p style="margin: 0; font-size: 0.78rem; line-height: 1.5; color: #5A6668">
          {@auth_copy.foot}
        </p>
      </div>
    </div>
  </main>
</div>
